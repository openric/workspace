#
# What a collaborator on a research project may do (Heratio's research_project_collaborator.role).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/project-role/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Research Project Roles"@en ;
    dcterms:description "What a collaborator on a research project may do (Heratio's research_project_collaborator.role)."@en ;
    dcterms:issued "2026-10-31"^^xsd:date ;
    skos:hasTopConcept v:owner, v:editor, v:contributor, v:viewer .

v:owner a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Owner"@en, "Eienaar"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "Made it; may do everything, and give it away."@en .

v:editor a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Editor"@en, "Redakteur"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "May change it, invite and remove collaborators, and remove what others added."@en .

v:contributor a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Contributor"@en, "Bydraer"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "May add to it."@en .

v:viewer a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Viewer"@en, "Kyker"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "May read it."@en .
