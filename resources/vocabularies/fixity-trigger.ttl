# What started a fixity run (Heratio's integrity_run.triggered_by).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/fixity-trigger/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Fixity Run Triggers"@en ;
    dcterms:description "What started a fixity run (Heratio's integrity_run.triggered_by)."@en ;
    dcterms:issued "2026-11-03"^^xsd:date ;
    skos:hasTopConcept v:scheduler, v:manual, v:command .

v:scheduler a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Scheduler"@en, "Skeduleerder"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's fixity checks, as Heratio's ahg-integrity keeps them; a check is a PREMIS fixity check event."@en ;
    skos:definition "A schedule fell due."@en .

v:manual a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "On request"@en, "Op versoek"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's fixity checks, as Heratio's ahg-integrity keeps them; a check is a PREMIS fixity check event."@en ;
    skos:definition "Someone asked for it."@en .

v:command a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Command"@en, "Opdrag"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's fixity checks, as Heratio's ahg-integrity keeps them; a check is a PREMIS fixity check event."@en ;
    skos:definition "The workspace:fixity command."@en .
