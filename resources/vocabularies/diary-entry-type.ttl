#
# What an entry of a researcher's diary records (Heratio's research_journal_entry.entry_type).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/diary-entry-type/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Research Diary Entry Types"@en ;
    dcterms:description "What an entry of a researcher's diary records (Heratio's research_journal_entry.entry_type)."@en ;
    dcterms:issued "2026-10-31"^^xsd:date ;
    skos:hasTopConcept v:manual, v:reflection, v:milestone, v:auto-booking, v:auto-material, v:auto-annotation, v:auto-search, v:auto-collection .

v:manual a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Entry"@en, "Inskrywing"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "Written by the researcher."@en .

v:reflection a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Reflection"@en, "Besinning"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "The researcher's thoughts on the work."@en .

v:milestone a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Milestone"@en, "Mylpaal"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "A point reached in the work."@en .

v:auto-booking a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Visit booked"@en, "Besoek bespreek"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "Written by the Workspace when the researcher booked the reading room."@en .

v:auto-material a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Material requested"@en, "Materiaal aangevra"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "Written by the Workspace when the researcher asked for a record to be brought."@en .

v:auto-annotation a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Annotation written"@en, "Annotasie geskryf"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "Written by the Workspace when the researcher annotated a record."@en .

v:auto-search a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Search saved"@en, "Soektog gestoor"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "Written by the Workspace when the researcher saved a search."@en .

v:auto-collection a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Collection changed"@en, "Versameling verander"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "Written by the Workspace when the researcher made a collection or added to one."@en .
