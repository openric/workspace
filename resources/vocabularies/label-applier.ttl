#
# Who applied a Traditional Knowledge or Biocultural Label (Heratio's icip_tk_label.applied_by).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/label-applier/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Label Appliers"@en ;
    dcterms:description "Who applied a Local Contexts Label to a record."@en ;
    dcterms:issued "2026-10-27"^^xsd:date ;
    skos:hasTopConcept v:community, v:institution .

v:community a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "The community"@en ;
    skos:scopeNote "Part of the description of a Label's rico:Rule; RiC-O 1.1 has no property for it."@en ;
    skos:definition "The community applied the Label, such as through the Local Contexts Hub."@en .

v:institution a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "The institution"@en ;
    skos:scopeNote "Part of the description of a Label's rico:Rule; RiC-O 1.1 has no property for it."@en ;
    skos:definition "The institution applied the Label, pending or after consultation with the community."@en .
