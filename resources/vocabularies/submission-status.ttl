# Where a researcher's submission stands (Heratio's researcher_submission.status).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/submission-status/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Researcher Submission Statuses"@en ;
    dcterms:description "Where a researcher's submission stands (Heratio's researcher_submission.status)."@en ;
    dcterms:issued "2026-10-31"^^xsd:date ;
    skos:hasTopConcept v:draft, v:submitted, v:under-review, v:approved, v:published, v:returned, v:rejected .

v:draft a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Draft"@en, "Konsep"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-researcher-manage keeps it."@en ;
    skos:definition "Being put together by the researcher."@en .

v:submitted a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Submitted"@en, "Ingedien"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-researcher-manage keeps it."@en ;
    skos:definition "Sent for review."@en .

v:under-review a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Under review"@en, "Word hersien"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-researcher-manage keeps it."@en ;
    skos:definition "Taken on by a reviewer."@en .

v:approved a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Approved"@en, "Goedgekeur"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-researcher-manage keeps it."@en ;
    skos:definition "Approved, to be published."@en .

v:published a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Published"@en, "Gepubliseer"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-researcher-manage keeps it."@en ;
    skos:definition "Its descriptions are in the catalogue."@en .

v:returned a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Returned"@en, "Teruggestuur"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-researcher-manage keeps it."@en ;
    skos:definition "Sent back to the researcher to change."@en .

v:rejected a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Rejected"@en, "Afgekeur"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-researcher-manage keeps it."@en ;
    skos:definition "Not to be published."@en .
