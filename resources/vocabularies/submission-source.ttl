# How a researcher's submission came in (Heratio's researcher_submission.source_type).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/submission-source/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Researcher Submission Sources"@en ;
    dcterms:description "How a researcher's submission came in (Heratio's researcher_submission.source_type)."@en ;
    dcterms:issued "2026-10-31"^^xsd:date ;
    skos:hasTopConcept v:online, v:offline .

v:online a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Online"@en, "Aanlyn"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-researcher-manage keeps it."@en ;
    skos:definition "Made in the Workspace."@en .

v:offline a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Offline"@en, "Vanlyn"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-researcher-manage keeps it."@en ;
    skos:definition "Imported from an exchange file made away from the Workspace."@en .
