# CAAIS 3.2.3 content type, the examples CAAIS 1.0 gives, as Heratio seeds them.

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/caais-content-type/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace CAAIS Content Types"@en ;
    dcterms:description "CAAIS 3.2.3 content type, the examples CAAIS 1.0 gives, as Heratio seeds them."@en ;
    dcterms:issued "2026-10-29"^^xsd:date ;
    skos:hasTopConcept v:architectural-technical-drawings, v:artefacts, v:cartographic, v:datasets, v:graphic, v:interactive, v:moving-images, v:natural-objects, v:philatelic, v:photographs, v:sound-recordings, v:textual .

v:architectural-technical-drawings a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Architectural and technical drawings"@en, "Argitektoniese en tegniese tekeninge"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the accession, as AtoM and Heratio keep it; given in the CAAIS export."@en .

