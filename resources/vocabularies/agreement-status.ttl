# Where a donor agreement stands (Heratio's donor_agreement.status).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/agreement-status/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Agreement Statuses"@en ;
    dcterms:description "Where a donor agreement stands (Heratio's donor_agreement.status)."@en ;
    dcterms:issued "2026-10-29"^^xsd:date ;
    skos:hasTopConcept v:draft, v:pending-review, v:pending-signature, v:active, v:expired, v:terminated, v:superseded .

v:draft a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Draft"@en, "Konsep"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the donor agreement, as Heratio keeps it."@en ;
    skos:definition "Being written; not yet sent for review."@en .

v:pending-review a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Pending review"@en, "Wag op hersiening"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the donor agreement, as Heratio keeps it."@en ;
    skos:definition "Written and waiting to be reviewed."@en .

v:pending-signature a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Pending signature"@en, "Wag op ondertekening"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the donor agreement, as Heratio keeps it."@en ;
    skos:definition "Reviewed and waiting to be signed."@en .

v:active a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Active"@en, "Aktief"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the donor agreement, as Heratio keeps it."@en ;
    skos:definition "Signed and in force."@en .

v:expired a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Expired"@en, "Verval"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the donor agreement, as Heratio keeps it."@en ;
    skos:definition "Its term is over."@en .

v:terminated a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Terminated"@en, "Beëindig"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the donor agreement, as Heratio keeps it."@en ;
    skos:definition "Ended before its term."@en .

v:superseded a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Superseded"@en, "Vervang"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the donor agreement, as Heratio keeps it."@en ;
    skos:definition "Replaced by a later agreement."@en .
