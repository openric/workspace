# How the browse list shows units of description (Heratio's display_mode).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/browse-view/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Browse Views"@en ;
    dcterms:description "How the browse list shows units of description (Heratio's display_mode)."@en ;
    dcterms:issued "2026-11-04"^^xsd:date ;
    skos:hasTopConcept v:list, v:table, v:cards .

v:list a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "List"@en, "Lys"@af ;
    skos:scopeNote "Not a RiC-O term: how the Workspace lists units of description when browsing, as Heratio's ahg-display browse settings do; not exported."@en ;
    skos:definition "One unit a line, with its level, reference code, dates, extent and a summary of its scope."@en .

v:table a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Table"@en, "Tabel"@af ;
    skos:scopeNote "Not a RiC-O term: how the Workspace lists units of description when browsing, as Heratio's ahg-display browse settings do; not exported."@en ;
    skos:definition "One unit a row, in columns that may be sorted."@en .

v:cards a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Cards"@en, "Kaarte"@af ;
    skos:scopeNote "Not a RiC-O term: how the Workspace lists units of description when browsing, as Heratio's ahg-display browse settings do; not exported."@en ;
    skos:definition "A tile for each unit with its first image."@en .
