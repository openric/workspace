    skos:notation "CC0-1.0" ;
    skos:prefLabel "CC0 1.0 Universal (public domain dedication)"@en ;
    skos:scopeNote "Exported by its Creative Commons IRI, as the rico:Rule a record or instantiation is associated with (rico:isAssociatedWithRule), and as dcterms:license."@en ;
    skos:definition "No rights reserved."@en .

