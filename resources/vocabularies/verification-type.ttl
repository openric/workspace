#
# How a researcher's identity or affiliation is verified (Heratio's research_verification.verification_type).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/verification-type/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Verification Types"@en ;
    dcterms:description "How a researcher's identity or affiliation is verified (Heratio's research_verification.verification_type)."@en ;
    dcterms:issued "2026-10-31"^^xsd:date ;
    skos:hasTopConcept v:id-document, v:institutional-letter, v:institutional-email, v:orcid .

v:id-document a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Identity document"@en, "Identiteitsdokument"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's reading room, as Heratio's ahg-research keeps it."@en ;
    skos:definition "An identity document was seen."@en .

v:institutional-letter a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Letter from an institution"@en, "Brief van 'n instelling"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's reading room, as Heratio's ahg-research keeps it."@en ;
    skos:definition "A letter from the researcher's institution."@en .

v:institutional-email a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Institutional email"@en, "Instellings-e-pos"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's reading room, as Heratio's ahg-research keeps it."@en ;
    skos:definition "An email address at the researcher's institution was confirmed."@en .

v:orcid a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "ORCID"@en, "ORCID"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's reading room, as Heratio's ahg-research keeps it."@en ;
    skos:definition "An ORCID iD was confirmed."@en .
