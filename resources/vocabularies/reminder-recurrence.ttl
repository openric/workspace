# How often a reminder comes again (Heratio's donor_agreement_reminder.recurrence_pattern).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/reminder-recurrence/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Reminder Recurrences"@en ;
    dcterms:description "How often a reminder comes again (Heratio's donor_agreement_reminder.recurrence_pattern)."@en ;
    dcterms:issued "2026-10-29"^^xsd:date ;
    skos:hasTopConcept v:daily, v:weekly, v:monthly, v:quarterly, v:yearly .

v:daily a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Daily"@en, "Daagliks"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the donor agreement, as Heratio keeps it."@en ;
    skos:definition "Every day."@en .

v:weekly a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Weekly"@en, "Weekliks"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the donor agreement, as Heratio keeps it."@en ;
    skos:definition "Every week."@en .

v:monthly a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Monthly"@en, "Maandeliks"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the donor agreement, as Heratio keeps it."@en ;
    skos:definition "Every month."@en .

v:quarterly a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Quarterly"@en, "Kwartaalliks"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the donor agreement, as Heratio keeps it."@en ;
    skos:definition "Every three months."@en .

v:yearly a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Yearly"@en, "Jaarliks"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the donor agreement, as Heratio keeps it."@en ;
    skos:definition "Every year."@en .
