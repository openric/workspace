#
# Where work sent to a vendor stands (Heratio's vendor_transaction_status dropdown).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/vendor-transaction-status/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Vendor Transaction Statuses"@en ;
    dcterms:description "Where work sent to a vendor stands (Heratio's vendor_transaction_status dropdown)."@en ;
    dcterms:issued "2026-11-03"^^xsd:date ;
    skos:hasTopConcept v:pending-approval, v:approved, v:dispatched, v:received-by-vendor, v:in-progress, v:completed, v:ready-for-collection, v:returned, v:cancelled .

v:pending-approval a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Pending approval"@en, "Wag op goedkeuring"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's vendors and the work they do on its records, as Heratio's ahg-vendor keeps it."@en ;
    skos:definition "Requested, not yet approved."@en .

v:approved a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Approved"@en, "Goedgekeur"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's vendors and the work they do on its records, as Heratio's ahg-vendor keeps it."@en ;
    skos:definition "Approved, not yet sent."@en .

v:dispatched a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Dispatched"@en, "Versend"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's vendors and the work they do on its records, as Heratio's ahg-vendor keeps it."@en ;
    skos:definition "Sent to the vendor."@en .

v:received-by-vendor a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Received by vendor"@en, "Deur verskaffer ontvang"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's vendors and the work they do on its records, as Heratio's ahg-vendor keeps it."@en ;
    skos:definition "The vendor has it."@en .

v:in-progress a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "In progress"@en, "Aan die gang"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's vendors and the work they do on its records, as Heratio's ahg-vendor keeps it."@en ;
    skos:definition "The work is being done."@en .

v:completed a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Completed"@en, "Voltooi"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's vendors and the work they do on its records, as Heratio's ahg-vendor keeps it."@en ;
    skos:definition "The work is done."@en .

v:ready-for-collection a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Ready for collection"@en, "Gereed vir afhaal"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's vendors and the work they do on its records, as Heratio's ahg-vendor keeps it."@en ;
    skos:definition "Waiting to be collected or sent back."@en .

v:returned a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Returned"@en, "Terugbesorg"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's vendors and the work they do on its records, as Heratio's ahg-vendor keeps it."@en ;
    skos:definition "Back with the institution."@en .

v:cancelled a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Cancelled"@en, "Gekanselleer"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's vendors and the work they do on its records, as Heratio's ahg-vendor keeps it."@en ;
    skos:definition "Not going ahead."@en .
