# How likely a file format is to become unreadable (Heratio's preservation_format.risk_level).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/format-risk/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Format Risk Levels"@en ;
    dcterms:description "How likely a file format is to become unreadable (Heratio's preservation_format.risk_level)."@en ;
    dcterms:issued "2026-11-03"^^xsd:date ;
    skos:hasTopConcept v:low, v:medium, v:high, v:critical .

v:low a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Low"@en, "Laag"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's preservation planning, as Heratio's ahg-preservation keeps it."@en ;
    skos:definition "Open, widely supported, well documented."@en .

v:medium a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Medium"@en, "Medium"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's preservation planning, as Heratio's ahg-preservation keeps it."@en ;
    skos:definition "Supported now, with some risk."@en .

v:high a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "High"@en, "Hoog"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's preservation planning, as Heratio's ahg-preservation keeps it."@en ;
    skos:definition "Proprietary, poorly documented or little supported."@en .

v:critical a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Critical"@en, "Kritiek"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's preservation planning, as Heratio's ahg-preservation keeps it."@en ;
    skos:definition "Obsolete or nearly so: plan its migration."@en .
