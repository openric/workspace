#
# The kinds of record a permission applies to: one permission matrix each, as
# Heratio has one ACL editor per class. Which actions apply to which kind is
# workspace.permission_matrix in config/workspace.php.

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/record-kind/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Record Kinds"@en ;
    dcterms:description "Kinds of record that permissions are granted on."@en ;
    dcterms:issued "2026-10-20"^^xsd:date ;
    skos:hasTopConcept v:institution, v:repository, v:description, v:vocabulary, v:authority, v:storage, v:accession .

v:institution a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Institution"@en ;
    skos:definition "The institution itself: its settings, accounts, roles and audit log."@en .

v:repository a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Repository"@en ;
    skos:definition "Repositories (ISDIAH)."@en .

v:description a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Archival description"@en ;
    skos:definition "Record sets, records and record parts (ISAD(G))."@en .

v:vocabulary a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Vocabularies and places"@en ;
    skos:definition "The institution's own vocabularies (subjects, occupation types, place types, documentary form types) and its places, as Heratio governs terms and places with one set of permissions."@en .


v:authority a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Authority records"@en ;
    skos:definition "Persons, families, corporate bodies, positions and mechanisms (ISAAR(CPF))."@en .

v:storage a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Physical storage"@en ;
    skos:definition "Containers, what they hold and where they are kept, and their movements. Storage places are places, under vocabularies and places."@en .

v:accession a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Accessions"@en ;
    skos:definition "Accession records: what the institution received, from whom and when, and what was deaccessioned. Staff only; never public."@en .
