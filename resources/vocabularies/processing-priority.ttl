# How soon an accession is to be processed (AtoM's accession processing priority taxonomy).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/processing-priority/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Processing Priorities"@en ;
    dcterms:description "How soon an accession is to be processed (AtoM's accession processing priority taxonomy)."@en ;
    dcterms:issued "2026-10-29"^^xsd:date ;
    skos:hasTopConcept v:high, v:medium, v:low .

v:high a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "High"@en, "Hoog"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the accession, as AtoM and Heratio keep it; given in the CAAIS export."@en .

v:medium a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Medium"@en, "Medium"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the accession, as AtoM and Heratio keep it; given in the CAAIS export."@en .

v:low a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Low"@en, "Laag"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the accession, as AtoM and Heratio keep it; given in the CAAIS export."@en .
