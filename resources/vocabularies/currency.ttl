# The currency of an amount, by its ISO 4217 code (Heratio's research_currency).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/currency/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Currencies"@en ;
    dcterms:description "The currency of an amount, by its ISO 4217 code (Heratio's research_currency)."@en ;
    dcterms:issued "2026-10-31"^^xsd:date ;
    skos:hasTopConcept v:ZAR, v:USD, v:EUR, v:GBP, v:AUD, v:CAD, v:JPY, v:CHF, v:CNY, v:INR, v:BRL, v:NZD, v:SEK, v:NOK, v:SGD, v:KES, v:NGN, v:AED, v:BWP, v:NAD, v:ZWG .

v:ZAR a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "ZAR - South African Rand"@en, "ZAR - Suid-Afrikaanse rand"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "South African Rand."@en .

