#
# How a peer answered a federated search (Heratio's federation_peer_search.last_search_status).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/federation-search-status/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Federation Search Statuses"@en ;
    dcterms:description "How a peer answered a federated search (Heratio's federation_peer_search.last_search_status)."@en ;
    dcterms:issued "2026-11-04"^^xsd:date ;
    skos:hasTopConcept v:success, v:timeout, v:error, v:skipped .

v:success a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Answered"@en, "Geantwoord"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's federation with its peers, as Heratio's ahg-federation keeps it."@en ;
    skos:definition "The peer answered with its results."@en .

v:timeout a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Timed out"@en, "Tyd verstryk"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's federation with its peers, as Heratio's ahg-federation keeps it."@en ;
    skos:definition "The peer did not answer in time."@en .

v:error a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Error"@en, "Fout"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's federation with its peers, as Heratio's ahg-federation keeps it."@en ;
    skos:definition "The peer answered with an error, or could not be reached."@en .

v:skipped a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Skipped"@en, "Oorgeslaan"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's federation with its peers, as Heratio's ahg-federation keeps it."@en ;
    skos:definition "Not asked: its address is not a public one, or it is switched off."@en .
