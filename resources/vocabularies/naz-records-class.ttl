# How important a series of records is to the agency (Heratio's naz_records_schedule.classification).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/naz-records-class/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace NAZ Records Classes"@en ;
    dcterms:description "How important a series of records is to the agency (Heratio's naz_records_schedule.classification)."@en ;
    dcterms:issued "2026-10-31"^^xsd:date ;
    skos:hasTopConcept v:vital, v:important, v:useful, v:non-essential .

v:vital a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Vital"@en, "Lewensbelangrik"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the records of the National Archives of Zimbabwe Act [Chapter 25:06], as Heratio's ahg-naz keeps it."@en ;
    skos:definition "Needed to go on working."@en .

v:important a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Important"@en, "Belangrik"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the records of the National Archives of Zimbabwe Act [Chapter 25:06], as Heratio's ahg-naz keeps it."@en ;
    skos:definition "Costly to replace."@en .

v:useful a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Useful"@en, "Nuttig"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the records of the National Archives of Zimbabwe Act [Chapter 25:06], as Heratio's ahg-naz keeps it."@en ;
    skos:definition "Of use."@en .

v:non-essential a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Non-essential"@en, "Nie noodsaaklik nie"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the records of the National Archives of Zimbabwe Act [Chapter 25:06], as Heratio's ahg-naz keeps it."@en ;
    skos:definition "Of little lasting use."@en .
