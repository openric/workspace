# Where the material stands now (Heratio's provenance_overview.current_status).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/provenance-current-status/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Provenance Current Statuses"@en ;
    dcterms:description "Where the material stands now (Heratio's provenance_overview.current_status)."@en ;
    dcterms:issued "2026-10-29"^^xsd:date ;
    skos:hasTopConcept v:owned, v:on-loan, v:deposited, v:disputed, v:unknown .

v:owned a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Owned"@en, "In besit"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the record's provenance overview, as Heratio keeps it."@en ;
    skos:definition "The institution owns it."@en .

v:on-loan a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "On loan"@en, "Op lening"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the record's provenance overview, as Heratio keeps it."@en ;
    skos:definition "It is on loan."@en .

v:deposited a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Deposited"@en, "In bewaring gegee"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the record's provenance overview, as Heratio keeps it."@en ;
    skos:definition "It is deposited."@en .

v:disputed a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Disputed"@en, "Betwis"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the record's provenance overview, as Heratio keeps it."@en ;
    skos:definition "Its ownership is disputed."@en .

v:unknown a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Unknown"@en, "Onbekend"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the record's provenance overview, as Heratio keeps it."@en ;
    skos:definition "Not known."@en .
