#
# Kinds of document kept with a donor agreement (Heratio's donor_agreement_document.document_type).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/agreement-document-type/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Agreement Document Types"@en ;
    dcterms:description "Kinds of document kept with a donor agreement (Heratio's donor_agreement_document.document_type)."@en ;
    dcterms:issued "2026-10-29"^^xsd:date ;
    skos:hasTopConcept v:signed-agreement, v:draft, v:amendment, v:addendum, v:schedule, v:correspondence, v:appraisal-report, v:inventory, v:deed-of-gift, v:transfer-form, v:receipt, v:payment-record, v:legal-opinion, v:board-resolution, v:donor-identification, v:provenance-evidence, v:valuation, v:insurance, v:photograph, v:other .

v:signed-agreement a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Signed agreement"@en, "Getekende ooreenkoms"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the document of the donor agreement, as Heratio keeps it."@en ;
    skos:definition "The agreement as signed."@en .

v:draft a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Draft"@en, "Konsep"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the document of the donor agreement, as Heratio keeps it."@en ;
    skos:definition "A draft of the agreement."@en .

v:amendment a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Amendment"@en, "Wysiging"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the document of the donor agreement, as Heratio keeps it."@en ;
    skos:definition "A change to the agreement."@en .

v:addendum a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Addendum"@en, "Byvoegsel"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the document of the donor agreement, as Heratio keeps it."@en ;
    skos:definition "An addition to the agreement."@en .

v:schedule a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Schedule"@en, "Bylae"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the document of the donor agreement, as Heratio keeps it."@en ;
    skos:definition "A schedule to the agreement, such as a list of items."@en .

v:correspondence a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Correspondence"@en, "Korrespondensie"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the document of the donor agreement, as Heratio keeps it."@en ;
    skos:definition "Letters and messages about the agreement."@en .

v:appraisal-report a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Appraisal report"@en, "Beoordelingsverslag"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the document of the donor agreement, as Heratio keeps it."@en ;
    skos:definition "A report on the material's archival value."@en .

v:inventory a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Inventory"@en, "Inventaris"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the document of the donor agreement, as Heratio keeps it."@en ;
    skos:definition "A list of what is covered."@en .

v:deed-of-gift a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Deed of gift"@en, "Skenkingsakte"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the document of the donor agreement, as Heratio keeps it."@en ;
    skos:definition "The deed of gift itself."@en .

v:transfer-form a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Transfer form"@en, "Oordragvorm"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the document of the donor agreement, as Heratio keeps it."@en ;
    skos:definition "The form that transferred the material."@en .

v:receipt a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Receipt"@en, "Ontvangsbewys"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the document of the donor agreement, as Heratio keeps it."@en ;
    skos:definition "A receipt for the material."@en .

v:payment-record a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Payment record"@en, "Betalingsrekord"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the document of the donor agreement, as Heratio keeps it."@en ;
    skos:definition "A record of a payment."@en .

v:legal-opinion a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Legal opinion"@en, "Regsmening"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the document of the donor agreement, as Heratio keeps it."@en ;
    skos:definition "A legal opinion on the agreement."@en .

v:board-resolution a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Board resolution"@en, "Raadsbesluit"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the document of the donor agreement, as Heratio keeps it."@en ;
    skos:definition "A resolution approving the agreement."@en .

v:donor-identification a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Donor identification"@en, "Skenker se identifikasie"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the document of the donor agreement, as Heratio keeps it."@en ;
