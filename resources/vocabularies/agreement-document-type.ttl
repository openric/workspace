v:provenance-evidence a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Provenance evidence"@en, "Herkomsbewys"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the document of the donor agreement, as Heratio keeps it."@en ;
    skos:definition "Evidence of where the material came from."@en .

v:valuation a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Valuation"@en, "Waardasie"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the document of the donor agreement, as Heratio keeps it."@en ;
    skos:definition "A valuation of the material."@en .

v:insurance a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Insurance"@en, "Versekering"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the document of the donor agreement, as Heratio keeps it."@en ;
    skos:definition "Insurance of the material."@en .

v:photograph a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
