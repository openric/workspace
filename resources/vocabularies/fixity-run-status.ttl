# How a fixity run ended (Heratio's integrity_run.status).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/fixity-run-status/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Fixity Run Statuses"@en ;
    dcterms:description "How a fixity run ended (Heratio's integrity_run.status)."@en ;
    dcterms:issued "2026-11-03"^^xsd:date ;
    skos:hasTopConcept v:running, v:completed, v:partial, v:failed .

v:running a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Running"@en, "Aan die gang"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's fixity checks, as Heratio's ahg-integrity keeps them; a check is a PREMIS fixity check event."@en ;
    skos:definition "Still checking."@en .

v:completed a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Completed"@en, "Voltooi"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's fixity checks, as Heratio's ahg-integrity keeps them; a check is a PREMIS fixity check event."@en ;
    skos:definition "Every file in scope was checked."@en .

v:partial a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Partial"@en, "Gedeeltelik"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's fixity checks, as Heratio's ahg-integrity keeps them; a check is a PREMIS fixity check event."@en ;
    skos:definition "Stopped at its limit of files or time; the rest wait for the next run."@en .

v:failed a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Failed"@en, "Misluk"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's fixity checks, as Heratio's ahg-integrity keeps them; a check is a PREMIS fixity check event."@en ;
    skos:definition "Stopped by an error."@en .
