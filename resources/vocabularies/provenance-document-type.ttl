# Kinds of document that support a provenance (Heratio's provenance_document.document_type).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/provenance-document-type/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Provenance Document Types"@en ;
    dcterms:description "Kinds of document that support a provenance (Heratio's provenance_document.document_type)."@en ;
    dcterms:issued "2026-10-29"^^xsd:date ;
    skos:hasTopConcept v:deed-of-gift, v:bill-of-sale, v:invoice, v:receipt, v:auction-catalog, v:exhibition-catalog, v:inventory, v:insurance-record, v:photograph, v:correspondence, v:certificate, v:customs-document, v:export-licence, v:import-permit, v:appraisal, v:condition-report, v:newspaper-clipping, v:publication, v:oral-history, v:affidavit, v:legal-document, v:other .

v:deed-of-gift a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Deed of Gift"@en, "Skenkingsakte"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the record's provenance overview, as Heratio keeps it."@en ;
    skos:definition "A deed of gift."@en .

