# What kind of body a vendor is (Heratio's vendor_type dropdown).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/vendor-type/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Vendor Types"@en ;
    dcterms:description "What kind of body a vendor is (Heratio's vendor_type dropdown)."@en ;
    dcterms:issued "2026-11-03"^^xsd:date ;
    skos:hasTopConcept v:company, v:individual, v:institution, v:government .

v:company a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Company"@en, "Maatskappy"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's vendors and the work they do on its records, as Heratio's ahg-vendor keeps it."@en ;
    skos:definition "A business."@en .

v:individual a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Individual"@en, "Individu"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's vendors and the work they do on its records, as Heratio's ahg-vendor keeps it."@en ;
    skos:definition "A person working on their own account."@en .

v:institution a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Institution"@en, "Instelling"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's vendors and the work they do on its records, as Heratio's ahg-vendor keeps it."@en ;
    skos:definition "Another archive, library, museum or university."@en .

v:government a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Government"@en, "Regering"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's vendors and the work they do on its records, as Heratio's ahg-vendor keeps it."@en ;
    skos:definition "A government department or agency."@en .
