#
# The kinds of work run in the background (roadmap phase 5; Heratio's ahg_job_execution.type).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/job-type/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Job Types"@en ;
    dcterms:description "The kinds of work the Workspace runs in the background."@en ;
    dcterms:issued "2026-10-27"^^xsd:date ;
    skos:hasTopConcept v:import, v:viewing-copies, v:file-text, v:embedded-metadata, v:read-page-text, v:ai-assist, v:offline-catalogue .

v:import a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Import"@en ;
    skos:scopeNote "Operational: the work of a background job, not part of any RiC description."@en ;
    skos:definition "Reading an import file: the dry run, or the import itself."@en .

v:viewing-copies a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Viewing copies"@en ;
    skos:scopeNote "Operational: the work of a background job, not part of any RiC description."@en ;
    skos:definition "Making the reference copy and thumbnail of an uploaded file."@en .

v:file-text a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "File text"@en ;
    skos:scopeNote "Operational: the work of a background job, not part of any RiC description."@en ;
    skos:definition "Reading the text layer of an uploaded PDF, proposed as the transcript of its instantiation."@en .

v:embedded-metadata a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Embedded metadata"@en ;
    skos:scopeNote "Operational: the work of a background job, not part of any RiC description."@en ;
    skos:definition "Reading the EXIF, IPTC, XMP or PDF metadata of an uploaded file, and proposing what a description can use."@en .

v:read-page-text a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Reading a page"@en ;
    skos:scopeNote "Operational: the work of a background job, not part of any RiC description."@en ;
    skos:definition "Reading the text of a page image with a vision model through the AI gateway, checked against Tesseract, and proposing it as the transcript of its instantiation (phase 17a)."@en .

v:ai-assist a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Asking a model"@en ;
    skos:scopeNote "Operational: the work of a background job, not part of any RiC description."@en ;
    skos:definition "Asking a model through the AI gateway to find names in a description, summarise its pages or assess the condition of an object from its picture, each answer proposed for review (phase 17b)."@en .

v:offline-catalogue a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Making an offline catalogue"@en, "Maak 'n aflyn-katalogus"@af ;
    skos:scopeNote "Operational: the work of a background job, not part of any RiC description."@en ;
    skos:definition "Writing descriptions, authority records, repositories and files into a package with a viewer that opens without a server, as Heratio's ahg-portable-export does (phase 11c)."@en .
