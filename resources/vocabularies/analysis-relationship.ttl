#
# What an analysis result does for a claim (Heratio's research_analysis_result_claim.relationship).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/analysis-relationship/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Analysis Result Relationships"@en ;
    dcterms:description "What an analysis result does for a claim (Heratio's research_analysis_result_claim.relationship)."@en ;
    dcterms:issued "2026-10-31"^^xsd:date ;
    skos:hasTopConcept v:supports, v:weakens, v:contextualises .

v:supports a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Supports"@en, "Steun"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "It bears the claim out."@en .

v:weakens a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Weakens"@en, "Verswak"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "It weakens the claim."@en .

v:contextualises a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Contextualises"@en, "Kontekstualiseer"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "It puts the claim in context."@en .
