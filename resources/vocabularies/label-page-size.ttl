#
# The sheet labels are printed on (Heratio's label_template.page_size).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/label-page-size/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Label Page Sizes"@en ;
    dcterms:description "The sheet labels are printed on (Heratio's label_template.page_size)."@en ;
    dcterms:issued "2026-10-31"^^xsd:date ;
    skos:hasTopConcept v:a4, v:letter .

v:a4 a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "A4 (210 x 297 mm)"@en, "A4 (210 x 297 mm)"@af ;
    skos:scopeNote "Not a RiC-O term: how the Workspace prints labels, as Heratio's ahg-label keeps it."@en ;
    skos:definition "The ISO A4 sheet."@en .

v:letter a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Letter (216 x 279 mm)"@en, "Letter (216 x 279 mm)"@af ;
    skos:scopeNote "Not a RiC-O term: how the Workspace prints labels, as Heratio's ahg-label keeps it."@en ;
    skos:definition "The US Letter sheet."@en .
