# Which way up a print template's page is (Heratio's research print template orientation).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/page-orientation/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Page Orientations"@en ;
    dcterms:description "Which way up a print template's page is (Heratio's research print template orientation)."@en ;
    dcterms:issued "2026-11-04"^^xsd:date ;
    skos:hasTopConcept v:portrait, v:landscape .

v:portrait a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Portrait"@en, "Staande"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's print templates for the reading room, as Heratio's ahg-research keeps them."@en ;
    skos:definition "Taller than wide."@en .

v:landscape a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Landscape"@en, "Liggende"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's print templates for the reading room, as Heratio's ahg-research keeps them."@en ;
    skos:definition "Wider than tall."@en .
