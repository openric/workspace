# The work a vendor does on records (Heratio's ahg_vendor_service_types).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/vendor-service-type/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Vendor Service Types"@en ;
    dcterms:description "The work a vendor does on records (Heratio's ahg_vendor_service_types)."@en ;
    dcterms:issued "2026-11-03"^^xsd:date ;
    skos:hasTopConcept v:conservation, v:restoration, v:framing, v:digitisation, v:photography, v:binding, v:cleaning, v:pest-treatment, v:storage-materials, v:transport, v:valuation, v:insurance, v:mounting, v:deacidification, v:encapsulation, v:other .

v:conservation a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Conservation"@en, "Konservering"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's vendors and the work they do on its records, as Heratio's ahg-vendor keeps it."@en ;
    skos:definition "Treatment to stabilise records."@en .

