# What a member of a research project's team does (Heratio's research_team_member.role).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/team-role/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Research Team Roles"@en ;
    dcterms:description "What a member of a research project's team does (Heratio's research_team_member.role)."@en ;
    dcterms:issued "2026-10-31"^^xsd:date ;
    skos:hasTopConcept v:principal-investigator, v:co-investigator, v:researcher, v:student, v:advisor, v:partner, v:technician, v:other .

v:principal-investigator a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Principal investigator"@en, "Hoofondersoeker"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "Leads the research."@en .

v:co-investigator a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Co-investigator"@en, "Mede-ondersoeker"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "Shares the lead."@en .

v:researcher a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Researcher"@en, "Navorser"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "Does the research."@en .

v:student a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Student"@en, "Student"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "A student."@en .

v:advisor a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Advisor"@en, "Adviseur"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "Advises."@en .

v:partner a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Partner"@en, "Vennoot"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "A partner."@en .

v:technician a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Technician"@en, "Tegnikus"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "Gives technical help."@en .

v:other a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Other"@en, "Ander"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "Something else."@en .
