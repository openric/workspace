#
# What a field alert tells of a cited work (Heratio's research_field_alert.alert_type).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/field-alert-type/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Field Alert Types"@en ;
    dcterms:description "What a field alert tells of a cited work (Heratio's research_field_alert.alert_type)."@en ;
    dcterms:issued "2026-10-31"^^xsd:date ;
    skos:hasTopConcept v:retraction, v:update, v:new-related .

v:retraction a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Retraction"@en, "Terugtrekking"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "The work is retracted."@en .

v:update a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Update"@en, "Bywerking"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "A correction, erratum or new version."@en .

v:new-related a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "New related work"@en, "Nuwe verwante werk"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "A new work related to it."@en .
