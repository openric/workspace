# Where a workflow task stands (Heratio's workflow_task_status and PSIS's statuses).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/workflow-task-status/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Workflow Task Statuses"@en ;
    dcterms:description "Where a workflow task stands (Heratio's workflow_task_status and PSIS's statuses)."@en ;
    dcterms:issued "2026-10-29"^^xsd:date ;
    skos:hasTopConcept v:pending, v:claimed, v:in-progress, v:returned, v:approved, v:rejected, v:cancelled .

v:pending a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Pending"@en, "Hangende"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the workflow, as Heratio's ahg-workflow keeps it."@en ;
    skos:definition "Waiting to be claimed or assigned."@en .

v:claimed a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Claimed"@en, "Geëis"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the workflow, as Heratio's ahg-workflow keeps it."@en ;
    skos:definition "Taken by someone."@en .

v:in-progress a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "In progress"@en, "Aan die gang"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the workflow, as Heratio's ahg-workflow keeps it."@en ;
    skos:definition "Being worked on."@en .

v:returned a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Returned"@en, "Teruggestuur"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the workflow, as Heratio's ahg-workflow keeps it."@en ;
    skos:definition "Returned to whoever submitted it, for revision."@en .

v:approved a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Approved"@en, "Goedgekeur"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the workflow, as Heratio's ahg-workflow keeps it."@en ;
    skos:definition "Done and approved."@en .

v:rejected a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Rejected"@en, "Afgekeur"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the workflow, as Heratio's ahg-workflow keeps it."@en ;
    skos:definition "Done and rejected."@en .

v:cancelled a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Cancelled"@en, "Gekanselleer"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the workflow, as Heratio's ahg-workflow keeps it."@en ;
    skos:definition "Stopped."@en .
