# What a research journal is (Heratio's research_journal.kind).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/journal-kind/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Research Journal Kinds"@en ;
    dcterms:description "What a research journal is (Heratio's research_journal.kind)."@en ;
    dcterms:issued "2026-10-31"^^xsd:date ;
    skos:hasTopConcept v:publication, v:manuscript .

v:publication a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Publication"@en, "Publikasie"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "A journal the institution or researcher publishes."@en .

v:manuscript a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Manuscript"@en, "Manuskrip"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "A manuscript being prepared for an outside journal."@en .
