# Whether something a member of the public contributed (a glossary entry, a transcription) is shown (Heratio's moderation_status).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/community-contribution-status/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Community Contribution Statuses"@en ;
    dcterms:description "Whether something a member of the public contributed (a glossary entry, a transcription) is shown (Heratio's moderation_status)."@en ;
    dcterms:issued "2026-11-06"^^xsd:date ;
    skos:hasTopConcept v:pending, v:approved, v:rejected .

v:pending a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Pending review"@en, "Wag op hersiening"@af ;
    skos:scopeNote "Not a RiC-O term: kept with what people contribute about the languages of a collection, as Heratio's ahg-semantic-search keeps it; shown once reviewed."@en ;
    skos:definition "Not yet reviewed, and not shown."@en .

v:approved a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Approved"@en, "Goedgekeur"@af ;
    skos:scopeNote "Not a RiC-O term: kept with what people contribute about the languages of a collection, as Heratio's ahg-semantic-search keeps it; shown once reviewed."@en ;
    skos:definition "Reviewed and shown."@en .

v:rejected a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Not published"@en, "Nie gepubliseer nie"@af ;
    skos:scopeNote "Not a RiC-O term: kept with what people contribute about the languages of a collection, as Heratio's ahg-semantic-search keeps it; shown once reviewed."@en ;
    skos:definition "Reviewed and not shown."@en .
