#
# What a right rests on (PREMIS rightsBasis; Heratio's rights_record.basis), the type of a right as a rico:Rule.

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/rights-basis/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Rights Bases"@en ;
    dcterms:description "What a right in a record or its instantiation rests on."@en ;
    dcterms:issued "2026-10-27"^^xsd:date ;
    skos:hasTopConcept v:copyright, v:licence, v:statute, v:donor, v:policy, v:other .

v:copyright a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Copyright"@en ;
    skos:scopeNote "Exported as the rico:RuleType of the rico:Rule, by rico:hasOrHadRuleType; PREMIS rightsBasis."@en ;
    skos:definition "The right comes from copyright in the material."@en .

v:licence a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Licence"@en ;
    skos:scopeNote "Exported as the rico:RuleType of the rico:Rule, by rico:hasOrHadRuleType; PREMIS rightsBasis."@en ;
    skos:definition "The right comes from a licence granted by the rights holder."@en .

v:statute a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Statute"@en ;
    skos:scopeNote "Exported as the rico:RuleType of the rico:Rule, by rico:hasOrHadRuleType; PREMIS rightsBasis."@en ;
    skos:definition "The right comes from a law or regulation."@en .

v:donor a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Donor agreement"@en ;
    skos:scopeNote "Exported as the rico:RuleType of the rico:Rule, by rico:hasOrHadRuleType; PREMIS rightsBasis."@en ;
    skos:definition "The right comes from the terms of a donation or deposit."@en .

v:policy a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Policy"@en ;
    skos:scopeNote "Exported as the rico:RuleType of the rico:Rule, by rico:hasOrHadRuleType; PREMIS rightsBasis."@en ;
    skos:definition "The right comes from a policy of the institution."@en .

v:other a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Other"@en ;
    skos:scopeNote "Exported as the rico:RuleType of the rico:Rule, by rico:hasOrHadRuleType; PREMIS rightsBasis."@en ;
    skos:definition "The right rests on another basis, given in its note."@en .
