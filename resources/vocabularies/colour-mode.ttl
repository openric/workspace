#
# Colour, greyscale or black and white (Heratio's research_reproduction_item.color_mode).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/colour-mode/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Colour Modes"@en ;
    dcterms:description "Colour, greyscale or black and white (Heratio's research_reproduction_item.color_mode)."@en ;
    dcterms:issued "2026-10-31"^^xsd:date ;
    skos:hasTopConcept v:colour, v:greyscale, v:black-and-white .

v:colour a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Colour"@en, "Kleur"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "In colour; costs half as much again."@en .

v:greyscale a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Greyscale"@en, "Grysskaal"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "In shades of grey."@en .

v:black-and-white a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Black and white"@en, "Swart en wit"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "In black and white only."@en .
