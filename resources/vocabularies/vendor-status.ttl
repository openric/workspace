#
# Whether work may be sent to a vendor (Heratio's vendor_status dropdown).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/vendor-status/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Vendor Statuses"@en ;
    dcterms:description "Whether work may be sent to a vendor (Heratio's vendor_status dropdown)."@en ;
    dcterms:issued "2026-11-03"^^xsd:date ;
    skos:hasTopConcept v:active, v:inactive, v:suspended, v:pending-approval .

v:active a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Active"@en, "Aktief"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's vendors and the work they do on its records, as Heratio's ahg-vendor keeps it."@en ;
    skos:definition "Work may be sent."@en .

v:inactive a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Inactive"@en, "Onaktief"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's vendors and the work they do on its records, as Heratio's ahg-vendor keeps it."@en ;
    skos:definition "No longer used."@en .

v:suspended a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Suspended"@en, "Opgeskort"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's vendors and the work they do on its records, as Heratio's ahg-vendor keeps it."@en ;
    skos:definition "Not to be used until reinstated."@en .

v:pending-approval a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Pending approval"@en, "Wag op goedkeuring"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's vendors and the work they do on its records, as Heratio's ahg-vendor keeps it."@en ;
    skos:definition "Not yet approved for use."@en .
