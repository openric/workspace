# What a scan for personal information read (Heratio's ahg_pii_scan_report.coverage).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/pii-scan-coverage/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Personal Information Scan Coverage"@en ;
    dcterms:description "What a scan for personal information read (Heratio's ahg_pii_scan_report.coverage)."@en ;
    dcterms:issued "2026-10-31"^^xsd:date ;
    skos:hasTopConcept v:metadata, v:files .

v:metadata a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "The description only"@en, "Slegs die beskrywing"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's privacy screening, as Heratio's ahg-privacy keeps it."@en ;
    skos:definition "The record's description and its files' embedded metadata; a file with no transcript was not read."@en .

v:files a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "The description and the files"@en, "Die beskrywing en die lêers"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's privacy screening, as Heratio's ahg-privacy keeps it."@en ;
    skos:definition "The record's description, its files' embedded metadata and the transcript of every file."@en .
