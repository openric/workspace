# What found a contradiction (Heratio's research_contradiction.source).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/contradiction-source/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Contradiction Sources"@en ;
    dcterms:description "What found a contradiction (Heratio's research_contradiction.source)."@en ;
    dcterms:issued "2026-10-31"^^xsd:date ;
    skos:hasTopConcept v:heuristic, v:ai .

v:heuristic a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Rules"@en, "Reëls"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "The engine's rules."@en .

v:ai a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "AI"@en, "KI"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "The AI services of phase 17."@en .
