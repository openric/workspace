# Where a transfer to the National Archives and Records Service of South Africa stands (Heratio's narssa_transfer.status).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/narssa-transfer-status/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace NARSSA Transfer Statuses"@en ;
    dcterms:description "Where a transfer to the National Archives and Records Service of South Africa stands (Heratio's narssa_transfer.status)."@en ;
    dcterms:issued "2026-10-31"^^xsd:date ;
    skos:hasTopConcept v:draft, v:packaged, v:transmitted, v:accepted, v:returned .

v:draft a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Draft"@en, "Konsep"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the transfer to the National Archives and Records Service of South Africa, as Heratio's ahg-narssa keeps it."@en ;
    skos:definition "Being put together."@en .

v:packaged a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Packaged"@en, "Verpak"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the transfer to the National Archives and Records Service of South Africa, as Heratio's ahg-narssa keeps it."@en ;
    skos:definition "The package is built."@en .

v:transmitted a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Transmitted"@en, "Gestuur"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the transfer to the National Archives and Records Service of South Africa, as Heratio's ahg-narssa keeps it."@en ;
    skos:definition "Sent to the National Archives."@en .

v:accepted a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Accepted"@en, "Aanvaar"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the transfer to the National Archives and Records Service of South Africa, as Heratio's ahg-narssa keeps it."@en ;
    skos:definition "The National Archives gave its receipt."@en .

v:returned a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Returned"@en, "Teruggestuur"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the transfer to the National Archives and Records Service of South Africa, as Heratio's ahg-narssa keeps it."@en ;
    skos:definition "Sent back by the National Archives."@en .
