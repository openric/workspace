# What was done in a workflow (Heratio's workflow_history_action).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/workflow-history-action/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Workflow History Actions"@en ;
    dcterms:description "What was done in a workflow (Heratio's workflow_history_action)."@en ;
    dcterms:issued "2026-10-29"^^xsd:date ;
    skos:hasTopConcept v:started, v:created, v:claimed, v:released, v:reassigned, v:approved, v:rejected, v:returned, v:resubmitted, v:escalated, v:cancelled, v:completed, v:comment, v:note-added, v:attachment-added, v:attachment-removed, v:rights-decision, v:publish, v:unpublish, v:priority-changed, v:due-date-changed, v:sla-breach, v:sla-policy-applied, v:sla-due-overridden .

v:started a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Started"@en, "Begin"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the workflow, as Heratio's ahg-workflow keeps it."@en ;
    skos:definition "A workflow was started."@en .

v:created a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Created"@en, "Geskep"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the workflow, as Heratio's ahg-workflow keeps it."@en ;
    skos:definition "A task was created for the next step."@en .

