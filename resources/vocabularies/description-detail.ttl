#
# How complete a description is, as the ICA standards record it in their control area (ISDIAH 5.6.5, ISAAR(CPF) 5.4.5, ISDF 5.4.5).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/description-detail/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Description Detail"@en ;
    dcterms:description "Level of detail of an archival description."@en ;
    dcterms:issued "2026-10-20"^^xsd:date ;
    skos:hasTopConcept v:minimal, v:partial, v:full .

v:minimal a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Minimal"@en ;
    skos:scopeNote "ISDIAH 5.6.5."@en ;
    skos:definition "Only the mandatory elements are described."@en .

v:partial a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Partial"@en ;
    skos:scopeNote "ISDIAH 5.6.5."@en ;
    skos:definition "Some optional elements are described as well."@en .

v:full a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Full"@en ;
    skos:scopeNote "ISDIAH 5.6.5."@en ;
    skos:definition "All relevant elements are described."@en .
