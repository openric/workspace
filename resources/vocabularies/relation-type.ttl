# OpenRiC Workspace - OpenRiC Workspace Relation Types.
# Copyright (C) 2026 Johan Pieterse / Plain Sailing Information Systems
# SPDX-License-Identifier: AGPL-3.0-or-later
#
# The type of a reified relation between two entities (ADR 0006): each concept names the RiC-O 1.1 Relation subclass and its shortcut properties. Which kinds of entity each type connects, and how it reads, are rows (migration 2026_10_29_000100), where an institution may add its own types narrowing these.

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/relation-type/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Relation Types"@en ;
    dcterms:description "What kind of relation connects two entities."@en ;
    dcterms:issued "2026-10-20"^^xsd:date ;
    skos:hasTopConcept v:associated-record, v:genetic, v:sequential, v:holding, v:creation, v:accumulation, v:management, v:ownership, v:agent-hierarchical, v:agent-temporal, v:agent-control, v:agent-associated, v:subject, v:place, v:place-containment, v:family, v:child, v:descendance, v:sibling, v:spouse, v:guardianship, v:adoption, v:fostering, v:membership, v:leadership, v:position-holding, v:position-in-group, v:group-subdivision, v:knowing, v:knowing-of, v:correspondence, v:teaching, v:study-at, v:work, v:occupation, v:legal-status, v:documentary-form, v:storage, v:location, v:performance, v:participation, v:result, v:documentation, v:subevent, v:material-creator, v:accrual, v:covers, v:partly-covers, v:refers-to .

v:associated-record a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Associated record resources"@en ;
    skos:scopeNote "Exported as a rico:RecordResourceToRecordResourceRelation, linked by rico:recordResourceToRecordResourceRelation_role; shortcut rico:isRecordResourceAssociatedWithRecordResource (symmetric). ISAD(G) 3.5.3."@en ;
    skos:definition "Two record resources that are related, such as related units of description."@en .

v:genetic a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Genetic link"@en ;
    skos:scopeNote "Exported as a rico:RecordResourceGeneticRelation, linked by rico:recordResourceGeneticRelation_role; shortcut rico:hasGeneticLinkToRecordResource (symmetric)."@en ;
    skos:definition "Two record resources linked by the way one was developed from the other, such as a draft and its final version."@en .

v:sequential a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Sequence"@en ;
    skos:scopeNote "Exported as a rico:SequentialRelation, linked by rico:sequentialRelation_role; shortcut rico:precedesOrPreceded, inverse rico:followsOrFollowed."@en ;
    skos:definition "One thing precedes or preceded another in a sequence."@en .

v:holding a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Holding"@en ;
    skos:scopeNote "Exported as a rico:RecordResourceHoldingRelation, linked by rico:recordResourceHoldingRelation_role; shortcut rico:isOrWasHolderOf, inverse rico:hasOrHadHolder. ISAD(G) 3.2.3, ISDIAH 5.3.7."@en ;
    skos:definition "An agent holds or held a record resource."@en .

v:creation a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Creation"@en ;
    skos:scopeNote "Exported as a rico:CreationRelation, linked by rico:creationRelation_role; shortcut rico:hasCreator, inverse rico:isCreatorOf. Role: rico:creationWithRole. ISAD(G) 3.2.1."@en ;
    skos:definition "An agent created a record resource, in a role."@en .

v:accumulation a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Accumulation"@en ;
    skos:scopeNote "Exported as a rico:AccumulationRelation, linked by rico:accumulationRelation_role; shortcut rico:hasAccumulator, inverse rico:isAccumulatorOf. ISAD(G) 3.2.1."@en ;
    skos:definition "An agent accumulated a record resource."@en .

v:management a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Management"@en ;
    skos:scopeNote "Exported as a rico:ManagementRelation, linked by rico:managementRelation_role; shortcut rico:isOrWasManagerOf, inverse rico:hasOrHadManager."@en ;
    skos:definition "An agent manages or managed a record resource."@en .

v:ownership a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Ownership"@en ;
    skos:scopeNote "Exported as a rico:OwnershipRelation, linked by rico:ownershipRelation_role; shortcut rico:isOrWasOwnerOf, inverse rico:hasOrHadOwner."@en ;
    skos:definition "An agent owns or owned a thing."@en .

v:agent-hierarchical a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Hierarchical (agents)"@en ;
    skos:scopeNote "Exported as a rico:AgentHierarchicalRelation, linked by rico:agentHierarchicalRelation_role; shortcut rico:hasOrHadSubordinate, inverse rico:isOrWasSubordinateTo. ISAAR(CPF) 5.3.2."@en ;
    skos:definition "One agent is or was subordinate to another."@en .

v:agent-temporal a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Succession (agents)"@en ;
    skos:scopeNote "Exported as a rico:AgentTemporalRelation, linked by rico:agentTemporalRelation_role; shortcut rico:hasSuccessor, inverse rico:isSuccessorOf. ISAAR(CPF) 5.3.2."@en ;
    skos:definition "One agent succeeded another."@en .

v:agent-control a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Control (agents)"@en ;
    skos:scopeNote "Exported as a rico:AgentControlRelation, linked by rico:agentControlRelation_role; shortcut rico:isOrWasControllerOf, inverse rico:hasOrHadController."@en ;
    skos:definition "One agent controls or controlled another."@en .

v:agent-associated a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Associated agents"@en ;
    skos:scopeNote "Exported as a rico:AgentToAgentRelation, linked by rico:agentToAgentRelation_role; shortcut rico:isAgentAssociatedWithAgent (symmetric). ISAAR(CPF) 5.3.2."@en ;
    skos:definition "Two agents that are or were associated."@en .

v:subject a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Subject"@en ;
    skos:scopeNote "Shortcut rico:hasOrHadSubject, inverse rico:isOrWasSubjectOf. RiC-O 1.1 has no Relation subclass for it; with its assertions, dates or evidence it is exported as a rico:Relation (rico:relation_role). Subject access points of ISAD(G) 3.1 and AtoM."@en ;
    skos:definition "A record resource is or was about a thing: a subject concept, a place or an agent."@en .

v:place a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Place"@en ;
    skos:scopeNote "Exported as a rico:PlaceRelation, linked by rico:placeRelation_role; shortcut rico:isPlaceAssociatedWith, inverse rico:isAssociatedWithPlace. Place access points of AtoM."@en ;
    skos:definition "A place is associated with the existence and lifecycle of a thing, such as a unit of description or an agent."@en .

v:place-containment a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Place containment"@en ;
    skos:scopeNote "Shortcut rico:containsOrContained, inverse rico:isOrWasContainedBy. RiC-O 1.1 has no Relation subclass for it; with its dates and assertions it is exported as a rico:Relation (rico:relation_role). The place a place lies in now is kept on the place itself; this records containment with its dates, such as a former one."@en ;
    skos:definition "A place contains or contained another, such as a district a farm lay in before a boundary changed."@en .

v:family a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Family association"@en ;
    skos:scopeNote "Exported as a rico:FamilyRelation, linked by rico:familyRelation_role; shortcut rico:hasFamilyAssociationWith (symmetric)."@en ;
    skos:definition "Two persons who belong to the same family."@en .

v:child a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Child"@en ;
    skos:scopeNote "Exported as a rico:ChildRelation, linked by rico:childRelation_role; shortcut rico:hasChild, inverse rico:isChildOf."@en ;
    skos:definition "A person is the parent of another."@en .

v:descendance a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Descendance"@en ;
    skos:scopeNote "Exported as a rico:DescendanceRelation, linked by rico:descendanceRelation_role; shortcut rico:hasDescendant, inverse rico:hasAncestor."@en ;
    skos:definition "A person is an ancestor of another, further back than a parent."@en .

v:sibling a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Siblings"@en ;
    skos:scopeNote "Exported as a rico:SiblingRelation, linked by rico:siblingRelation_role; shortcut rico:hasSibling (symmetric)."@en ;
    skos:definition "Two persons are siblings."@en .

v:spouse a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Spouses"@en ;
    skos:scopeNote "Exported as a rico:SpouseRelation, linked by rico:spouseRelation_role; shortcut rico:hasOrHadSpouse (symmetric)."@en ;
    skos:definition "Two persons are or were married."@en .

v:guardianship a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Guardianship"@en ;
    skos:scopeNote "Exported as a rico:FamilyRelation, linked by rico:familyRelation_role; shortcut openricx:isOrWasGuardianOf, inverse openricx:isOrWasUnderGuardianshipOf (extension ontology 1.4.0, a subproperty of rico:hasFamilyAssociationWith)."@en ;
    skos:definition "An agent is or was the legal guardian of a person."@en .

v:adoption a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Adoption"@en ;
    skos:scopeNote "Exported as a rico:ChildRelation, linked by rico:childRelation_role; shortcut openricx:hasAdoptedChild, inverse openricx:isOrWasAdoptedChildOf (extension ontology 1.4.0, a subproperty of rico:hasChild)."@en ;
    skos:definition "A person adopted another as their child."@en .

v:fostering a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Fostering"@en ;
    skos:scopeNote "Exported as a rico:FamilyRelation, linked by rico:familyRelation_role; shortcut openricx:hasFosterChild, inverse openricx:isOrWasFosterChildOf (extension ontology 1.4.0, a subproperty of rico:hasFamilyAssociationWith)."@en ;
    skos:definition "An agent fostered a person, in care without legal adoption."@en .

v:membership a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Membership"@en ;
    skos:scopeNote "Exported as a rico:MembershipRelation, linked by rico:membershipRelation_role; shortcut rico:hasOrHadMember, inverse rico:isOrWasMemberOf."@en ;
    skos:definition "A person is or was a member of a family or corporate body."@en .

v:leadership a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Leadership"@en ;
    skos:scopeNote "Exported as a rico:LeadershipRelation, linked by rico:leadershipRelation_role; shortcut rico:isOrWasLeaderOf, inverse rico:hasOrHadLeader."@en ;
    skos:definition "A person leads or led a family or corporate body."@en .

v:position-holding a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Position holding"@en ;
    skos:scopeNote "Exported as a rico:PositionHoldingRelation, linked by rico:positionHoldingRelation_role; shortcut rico:occupiesOrOccupied, inverse rico:isOrWasOccupiedBy."@en ;
    skos:definition "A person occupies or occupied a position."@en .

v:position-in-group a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Position in a group"@en ;
    skos:scopeNote "Exported as a rico:PositionToGroupRelation, linked by rico:positionToGroupRelation_role; shortcut rico:existsOrExistedIn, inverse rico:hasOrHadPosition."@en ;
    skos:definition "A position exists or existed in a corporate body or family."@en .

v:group-subdivision a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Subdivision"@en ;
    skos:scopeNote "Exported as a rico:GroupSubdivisionRelation, linked by rico:groupSubdivisionRelation_role; shortcut rico:hasOrHadSubdivision, inverse rico:isOrWasSubdivisionOf."@en ;
    skos:definition "A corporate body or family is or was a subdivision of another, such as a department of a ministry."@en .

v:knowing a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Acquaintance"@en ;
    skos:scopeNote "Exported as a rico:KnowingRelation, linked by rico:knowingRelation_role; shortcut rico:knows (symmetric)."@en ;
    skos:definition "Two persons knew each other directly."@en .

v:knowing-of a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Knowing of"@en ;
    skos:scopeNote "Exported as a rico:KnowingOfRelation, linked by rico:knowingOfRelation_role; shortcut rico:knowsOf, inverse rico:knownBy."@en ;
    skos:definition "A person knew of another without knowing them directly."@en .

v:correspondence a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Correspondence"@en ;
    skos:scopeNote "Exported as a rico:CorrespondenceRelation, linked by rico:correspondenceRelation_role; shortcut rico:hasOrHadCorrespondent (symmetric)."@en ;
    skos:definition "Two persons corresponded with each other."@en .

v:teaching a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Teaching"@en ;
    skos:scopeNote "Exported as a rico:TeachingRelation, linked by rico:teachingRelation_role; shortcut rico:hasOrHadStudent, inverse rico:hasOrHadTeacher."@en ;
    skos:definition "A person taught another."@en .

v:study-at a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Study"@en ;
    skos:scopeNote "Exported as a rico:StudyAtRelation, linked by rico:studyAtRelation_role; shortcut rico:isOrWasAttendedByStudent, inverse rico:studiesOrStudiedAt."@en ;
    skos:definition "A person studied at a corporate body, such as a school or university."@en .

v:work a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Work relation"@en ;
    skos:scopeNote "Exported as a rico:WorkRelation, linked by rico:workRelation_role; shortcut rico:hasOrHadWorkRelationWith (symmetric)."@en ;
    skos:definition "Two agents work or worked together in the course of their activities."@en .

v:occupation a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Occupation"@en ;
    skos:scopeNote "Shortcut rico:hasOrHadOccupationOfType from a rico:Person to a rico:OccupationType; with its dates it is exported as an openricx:Occupation (extension ontology 1.4.0), which RiC-O 1.1 lacks. ISAAR(CPF) 5.2.5."@en ;
    skos:definition "A person pursues or pursued an occupation of a kind, such as attorney or carpenter."@en .

v:legal-status a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Legal status"@en ;
    skos:scopeNote "Shortcut rico:hasOrHadLegalStatus from a rico:Agent to a rico:LegalStatus; RiC-O 1.1 has no Relation subclass for it, so with its dates it is exported as a rico:Relation. ISAAR(CPF) 5.2.4."@en ;
    skos:definition "An agent has or had a legal status, such as a company or a trust."@en .

v:documentary-form a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Documentary form type"@en ;
    skos:scopeNote "Shortcut rico:hasDocumentaryFormType from a rico:Record or rico:RecordPart to a rico:DocumentaryFormType, inverse rico:isDocumentaryFormTypeOf; from a rico:RecordSet, which RiC-O 1.1 types only through its members, it is rico:hasOrHadSomeMembersWithDocumentaryFormType. RiC-O 1.1 has no Relation subclass for it. Genre access points of AtoM and EAD (genreform)."@en ;
    skos:definition "A record is of a documentary form, such as a letter, a minute book or a photograph album; a record set has members of that form."@en .

v:storage a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Storage"@en ;
    skos:scopeNote "Shortcut openricx:isOrWasStoredIn (extension ontology 1.6.0), inverse openricx:storesOrStored; RiC-O 1.1 has no storage relation, so its dates go on a rico:Relation. AtoM's link from a description to a physical object."@en ;
    skos:definition "A unit of description, an instantiation or a smaller container is or was kept in a container."@en .

v:location a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Storage location"@en ;
    skos:scopeNote "Shortcut rico:hasOrHadLocation, inverse rico:isOrWasLocationOf, from a container to a storage place; RiC-O 1.1 has no Relation subclass for it, so its dates go on a rico:Relation. Its dates are the container's movements."@en ;
    skos:definition "A container is or was kept in a storage place, from one date to another."@en .

v:performance a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Performance"@en ;
    skos:scopeNote "Exported as a rico:PerformanceRelation, linked by rico:performanceRelation_role; shortcut rico:isOrWasPerformedBy, inverse rico:performsOrPerformed."@en ;
    skos:definition "An agent performs or performed an activity, in a role."@en .

v:participation a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Participation"@en ;
    skos:scopeNote "Shortcut rico:hasOrHadParticipant, inverse rico:isOrWasParticipantIn. RiC-O 1.1 has no Relation subclass for it; with its role (openricx:relationHasAgentRole), dates, assertions or evidence it is exported as a rico:Relation (rico:relation_role)."@en ;
    skos:definition "A thing, such as a person, takes or took part in an activity, actively or passively, in a role such as spouse or witness."@en .

v:result a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Result"@en ;
    skos:scopeNote "Shortcut rico:resultsOrResultedIn, inverse rico:resultsOrResultedFrom. RiC-O 1.1 has no Relation subclass for it; with its dates, assertions or evidence it is exported as a rico:Relation (rico:relation_role). A production activity names what it resulted in (Provenance and Event profile)."@en ;
    skos:definition "An activity results or resulted in a thing, such as the records it produced."@en .

v:documentation a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Documentation"@en ;
    skos:scopeNote "Exported as a rico:ActivityDocumentationRelation, linked by rico:activityDocumentationRelation_role; shortcut rico:documents, inverse rico:documentedBy."@en ;
    skos:definition "A record resource documents an activity: it was made in the course of it or records it."@en .

v:subevent a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Part of an activity"@en ;
    skos:scopeNote "Shortcut rico:hasOrHadSubevent, inverse rico:isOrWasSubeventOf. RiC-O 1.1 has no Relation subclass for it; with its dates or assertions it is exported as a rico:Relation (rico:relation_role)."@en ;
    skos:definition "An activity is or was one of the activities that make up a broader one."@en .

v:material-creator a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Creator of accessioned material"@en ;
    skos:scopeNote "Exported as rico:isRelatedTo: AtoM's and Heratio's creators of an accession, an agent who created material the accession brought in, before any description of it names the agent as its creator."@en ;
    skos:definition "An agent who created material that an accession brought in."@en .

v:accrual a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Accrual"@en ;
    skos:scopeNote "Exported as rico:isRelatedTo: AtoM's and Heratio's accrual, a later accession that adds to an earlier one."@en ;
    skos:definition "A later accession adds to an earlier one."@en .

v:covers a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Coverage by an agreement"@en ;
    skos:scopeNote "Shortcut rico:hasOrHadSubject, inverse rico:isOrWasSubjectOf, from a donor agreement (a rico:Record) to the unit of description it covers; RiC-O 1.1 has no Relation subclass for it, so its dates go on a rico:Relation. Heratio's donor_agreement_record, covers."@en ;
    skos:definition "A donor agreement covers a unit of description."@en .

v:partly-covers a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Partial coverage by an agreement"@en ;
    skos:scopeNote "Shortcut rico:hasOrHadSubject, inverse rico:isOrWasSubjectOf, from a donor agreement (a rico:Record) to a unit of description it covers in part; RiC-O 1.1 has no Relation subclass for it, so its dates go on a rico:Relation. Heratio's donor_agreement_record, partially covers."@en ;
    skos:definition "A donor agreement covers part of a unit of description."@en .

v:refers-to a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Reference from an agreement"@en ;
    skos:scopeNote "Exported as a rico:RecordResourceToRecordResourceRelation, linked by rico:recordResourceToRecordResourceRelation_role; shortcut rico:isRecordResourceAssociatedWithRecordResource. Heratio's donor_agreement_record, references: a donor agreement names a unit of description it does not cover."@en ;
    skos:definition "A donor agreement refers to a unit of description."@en .
