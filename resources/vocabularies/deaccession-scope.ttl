# Whether a deaccession takes the whole accession or part of it (AtoM's deaccession scope taxonomy).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/deaccession-scope/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Deaccession Scopes"@en ;
    dcterms:description "Whether a deaccession takes the whole accession or part of it (AtoM's deaccession scope taxonomy)."@en ;
    dcterms:issued "2026-10-29"^^xsd:date ;
    skos:hasTopConcept v:whole, v:part .

v:whole a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Whole"@en, "Geheel"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the accession, as AtoM and Heratio keep it; given in the CAAIS export."@en .

v:part a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Part"@en, "Deel"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the accession, as AtoM and Heratio keep it; given in the CAAIS export."@en .
