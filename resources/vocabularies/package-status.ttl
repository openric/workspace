# Where an information package stands (Heratio's preservation_package.status).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/package-status/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Package Statuses"@en ;
    dcterms:description "Where an information package stands (Heratio's preservation_package.status)."@en ;
    dcterms:issued "2026-11-04"^^xsd:date ;
    skos:hasTopConcept v:building, v:complete, v:validated, v:exported, v:error .

v:building a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Building"@en, "Word gebou"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's preservation packages, as Heratio's ahg-preservation keeps them."@en ;
    skos:definition "Being put together."@en .

v:complete a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Complete"@en, "Voltooi"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's preservation packages, as Heratio's ahg-preservation keeps them."@en ;
    skos:definition "Put together and kept."@en .

v:validated a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Validated"@en, "Gevalideer"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's preservation packages, as Heratio's ahg-preservation keeps them."@en ;
    skos:definition "Checked as a valid BagIt bag, every file against its manifest."@en .

v:exported a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Exported"@en, "Uitgevoer"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's preservation packages, as Heratio's ahg-preservation keeps them."@en ;
    skos:definition "Downloaded or sent on."@en .

v:error a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Error"@en, "Fout"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's preservation packages, as Heratio's ahg-preservation keeps them."@en ;
    skos:definition "Could not be built, or did not validate; the reason is kept."@en .
