# The kind of owner or holder in a provenance step (Heratio's provenance_entry.owner_type).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/provenance-owner-type/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Provenance Owner Types"@en ;
    dcterms:description "The kind of owner or holder in a provenance step (Heratio's provenance_entry.owner_type)."@en ;
    dcterms:issued "2026-10-29"^^xsd:date ;
    skos:hasTopConcept v:unknown, v:person, v:family, v:organization, v:institution, v:dealer, v:auction-house, v:museum, v:corporate, v:government, v:religious, v:artist .

v:unknown a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Unknown"@en, "Onbekend"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the provenance step, as Heratio keeps it."@en ;
    skos:definition "Not known."@en .

v:person a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Person"@en, "Persoon"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the provenance step, as Heratio keeps it."@en ;
    skos:definition "A person."@en .

v:family a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Family"@en, "Familie"@af ;
