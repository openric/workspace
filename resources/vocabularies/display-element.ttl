#
# The elements of each display standard other than ISAD(G) (display-standard vocabulary), in the order the standard
# lists them, from Heratio's DACS, RAD, Dublin Core and MODS templates (ahg-dacs-manage, ahg-rad-manage, ahg-dc-manage,
# ahg-mods-manage and their show pages) under AtoM's labels. Each names its number in the standard, where it has one,
# and the description element it shows ("shows" in the scope note): a value is kept once, under its element, and every
# standard shows the same value. A standard shows only the elements it lists.

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/display-element/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Display Elements"@en ;
    dcterms:description "The elements each display standard shows, with their numbers and labels in it."@en ;
    dcterms:issued "2026-10-29"^^xsd:date ;
    skos:hasTopConcept v:dacs, v:rad, v:dc, v:mods .

