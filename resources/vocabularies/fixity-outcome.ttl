#
# What a fixity check found (Heratio's integrity_ledger.outcome).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/fixity-outcome/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Fixity Check Outcomes"@en ;
    dcterms:description "What a fixity check found (Heratio's integrity_ledger.outcome)."@en ;
    dcterms:issued "2026-11-03"^^xsd:date ;
    skos:hasTopConcept v:pass, v:mismatch, v:missing .

v:pass a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Unchanged"@en, "Onveranderd"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's fixity checks, as Heratio's ahg-integrity keeps them; a check is a PREMIS fixity check event."@en ;
    skos:definition "The file has the size and SHA-256 it came in with."@en .

v:mismatch a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Changed"@en, "Verander"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's fixity checks, as Heratio's ahg-integrity keeps them; a check is a PREMIS fixity check event."@en ;
    skos:definition "The file is there but its size or SHA-256 differs."@en .

v:missing a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Missing"@en, "Ontbreek"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's fixity checks, as Heratio's ahg-integrity keeps them; a check is a PREMIS fixity check event."@en ;
    skos:definition "The file is not in the object store."@en .
