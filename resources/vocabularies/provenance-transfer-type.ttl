# How a provenance step passed the material on (Heratio's provenance_entry.transfer_type, in its groups).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/provenance-transfer-type/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Provenance Transfer Types"@en ;
    dcterms:description "How a provenance step passed the material on (Heratio's provenance_entry.transfer_type, in its groups)."@en ;
    dcterms:issued "2026-10-29"^^xsd:date ;
    skos:hasTopConcept v:sale, v:purchase, v:auction, v:gift, v:donation, v:bequest, v:inheritance, v:descent, v:transfer, v:exchange, v:loan-out, v:loan-return, v:deposit, v:withdrawal, v:creation, v:commission, v:discovery, v:excavation, v:found, v:theft, v:recovery, v:confiscation, v:restitution, v:repatriation, v:accessioning, v:deaccessioning, v:unknown, v:other .

