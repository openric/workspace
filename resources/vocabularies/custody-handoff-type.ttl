#
# Each passing of a requested item from hand to hand (Heratio's research_custody_handoff.handoff_type).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/custody-handoff-type/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Custody Handoffs"@en ;
    dcterms:description "Each passing of a requested item from hand to hand (Heratio's research_custody_handoff.handoff_type)."@en ;
    dcterms:issued "2026-10-31"^^xsd:date ;
    skos:hasTopConcept v:checkout, v:checkin, v:transfer, v:return-to-storage, v:condition-check .

v:checkout a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Checked out"@en, "Uitgeteken"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's reading room, as Heratio's ahg-research keeps it."@en ;
    skos:definition "Given to the researcher."@en .

v:checkin a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Checked in"@en, "Ingeteken"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's reading room, as Heratio's ahg-research keeps it."@en ;
    skos:definition "Received back from the researcher."@en .

v:transfer a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Transferred"@en, "Oorgedra"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's reading room, as Heratio's ahg-research keeps it."@en ;
    skos:definition "Passed between staff or places."@en .

v:return-to-storage a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Returned to storage"@en, "Na bewaring terugbesorg"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's reading room, as Heratio's ahg-research keeps it."@en ;
    skos:definition "Put back in storage."@en .

v:condition-check a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Condition checked"@en, "Toestand nagegaan"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's reading room, as Heratio's ahg-research keeps it."@en ;
    skos:definition "Its condition was checked."@en .
