# CAAIS 3.2.2 unit of measure, the examples CAAIS 1.0 gives, as Heratio seeds them.

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/caais-extent-unit/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace CAAIS Extent Units"@en ;
    dcterms:description "CAAIS 3.2.2 unit of measure, the examples CAAIS 1.0 gives, as Heratio seeds them."@en ;
    dcterms:issued "2026-10-29"^^xsd:date ;
    skos:hasTopConcept v:linear-metres, v:centimetres, v:boxes, v:folders, v:items, v:volumes, v:carriers, v:files, v:megabytes, v:gigabytes, v:terabytes .

v:linear-metres a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Linear metres"@en, "Strekkende meter"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the accession, as AtoM and Heratio keep it; given in the CAAIS export."@en .

v:centimetres a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Centimetres"@en, "Sentimeter"@af ;
