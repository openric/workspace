# Under which part of PAIA a request is made (Heratio's privacy_paia_request.paia_section).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/paia-section/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace PAIA Request Kinds"@en ;
    dcterms:description "Under which part of PAIA a request is made (Heratio's privacy_paia_request.paia_section)."@en ;
    dcterms:issued "2026-10-31"^^xsd:date ;
    skos:hasTopConcept v:public-body, v:private-body, v:own-information .

v:public-body a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "A public body's record"@en, "Rekord van 'n openbare liggaam"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's privacy registers, as Heratio's ahg-privacy keeps it."@en ;
    skos:definition "A record of a public body (PAIA s.18, Form A)."@en .

v:private-body a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "A private body's record"@en, "Rekord van 'n private liggaam"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's privacy registers, as Heratio's ahg-privacy keeps it."@en ;
    skos:definition "A record of a private body (PAIA s.53, Form C)."@en .

v:own-information a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Own personal information"@en, "Eie persoonlike inligting"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's privacy registers, as Heratio's ahg-privacy keeps it."@en ;
    skos:definition "The requester's own personal information."@en .
