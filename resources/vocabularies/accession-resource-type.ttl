#
# Whether an accession came from a public body or a private one (AtoM's accession resource type taxonomy).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/accession-resource-type/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Accession Resource Types"@en ;
    dcterms:description "Whether an accession came from a public body or a private one (AtoM's accession resource type taxonomy)."@en ;
    dcterms:issued "2026-10-29"^^xsd:date ;
    skos:hasTopConcept v:public-transfer, v:private-transfer .

v:public-transfer a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Public transfer"@en, "Openbare oordrag"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the accession, as AtoM and Heratio keep it; given in the CAAIS export."@en .

v:private-transfer a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Private transfer"@en, "Private oordrag"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the accession, as AtoM and Heratio keep it; given in the CAAIS export."@en .
