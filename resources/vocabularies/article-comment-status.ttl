#
# Whether a visitor's comment on an article is shown (Heratio's blog_comment.status).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/article-comment-status/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Article Comment Statuses"@en ;
    dcterms:description "Whether a visitor's comment on an article is shown (Heratio's blog_comment.status)."@en ;
    dcterms:issued "2026-11-04"^^xsd:date ;
    skos:hasTopConcept v:approved, v:pending, v:spam .

v:approved a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Approved"@en, "Goedgekeur"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's articles on its public site, as Heratio's ahg-articles keeps them."@en ;
    skos:definition "Shown under the article."@en .

v:pending a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Pending"@en, "Hangende"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's articles on its public site, as Heratio's ahg-articles keeps them."@en ;
    skos:definition "Held until an editor looks at it."@en .

v:spam a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Spam"@en, "Gemors"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's articles on its public site, as Heratio's ahg-articles keeps them."@en ;
    skos:definition "Kept out of sight as unwanted."@en .
