#
# What a date on a project's timeline marks (Heratio's research_timeline_event.date_type).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/timeline-date-type/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Timeline Date Types"@en ;
    dcterms:description "What a date on a project's timeline marks (Heratio's research_timeline_event.date_type)."@en ;
    dcterms:issued "2026-10-31"^^xsd:date ;
    skos:hasTopConcept v:event, v:creation, v:accession, v:publication .

v:event a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Event"@en, "Gebeurtenis"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "Something that happened."@en .

v:creation a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Creation"@en, "Skepping"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "When something was made."@en .

v:accession a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Accession"@en, "Aanwins"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "When something came into an archive."@en .

v:publication a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Publication"@en, "Publikasie"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "When something was published."@en .
