# The DCMI Type Vocabulary, AtoM's Dublin Core type taxonomy (Heratio's dcTypeIds).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/dcmi-type/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace DCMI Types"@en ;
    dcterms:description "The DCMI Type Vocabulary, AtoM's Dublin Core type taxonomy (Heratio's dcTypeIds)."@en ;
    dcterms:issued "2026-10-29"^^xsd:date ;
    skos:hasTopConcept v:collection, v:dataset, v:event, v:image, v:interactive-resource, v:moving-image, v:physical-object, v:service, v:software, v:sound, v:still-image, v:text .

v:collection a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Collection"@en, "Versameling"@af ;
    skos:scopeNote "Exported as dc:type, by its label; not exported in RiC, which keeps no such list."@en .

v:dataset a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Dataset"@en, "Datastel"@af ;
    skos:scopeNote "Exported as dc:type, by its label; not exported in RiC, which keeps no such list."@en .

v:event a skos:Concept ;
