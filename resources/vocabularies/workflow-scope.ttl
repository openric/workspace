#
# Where a workflow applies (Heratio's ahg_workflow.scope_type).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/workflow-scope/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Workflow Scopes"@en ;
    dcterms:description "Where a workflow applies (Heratio's ahg_workflow.scope_type)."@en ;
    dcterms:issued "2026-10-29"^^xsd:date ;
    skos:hasTopConcept v:global, v:repository, v:collection .

v:global a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Global"@en, "Globaal"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the workflow, as Heratio's ahg-workflow keeps it."@en ;
    skos:definition "Everywhere in the institution, as its default."@en .

v:repository a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Repository"@en, "Bewaarplek"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the workflow, as Heratio's ahg-workflow keeps it."@en ;
    skos:definition "The descriptions a repository holds."@en .

v:collection a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Collection"@en, "Versameling"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the workflow, as Heratio's ahg-workflow keeps it."@en ;
    skos:definition "A unit of description and everything inside it."@en .
