#
# Where a request for access to a classified record stands (Heratio's security_access_request.status).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/clearance-request-status/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Clearance Request Statuses"@en ;
    dcterms:description "Where a request for access to a classified record stands (Heratio's security_access_request.status)."@en ;
    dcterms:issued "2026-10-31"^^xsd:date ;
    skos:hasTopConcept v:pending, v:approved, v:denied .

v:pending a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Pending"@en, "Hangende"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's security clearance, as Heratio's ahg-security-clearance keeps it."@en ;
    skos:definition "Waiting for a decision."@en .

v:approved a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Approved"@en, "Goedgekeur"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's security clearance, as Heratio's ahg-security-clearance keeps it."@en ;
    skos:definition "Access granted, for a time."@en .

v:denied a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Denied"@en, "Geweier"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's security clearance, as Heratio's ahg-security-clearance keeps it."@en ;
    skos:definition "Not granted."@en .
