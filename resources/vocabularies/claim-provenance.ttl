# Where a claim comes from (Heratio's research_claim_meta.provenance_kind).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/claim-provenance/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Claim Provenance Kinds"@en ;
    dcterms:description "Where a claim comes from (Heratio's research_claim_meta.provenance_kind)."@en ;
    dcterms:issued "2026-10-31"^^xsd:date ;
    skos:hasTopConcept v:original, v:derived, v:speculative .

v:original a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Original"@en, "Oorspronklik"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "The researcher's own."@en .

v:derived a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Derived"@en, "Afgelei"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "Derived from another's work."@en .

v:speculative a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Speculative"@en, "Spekulatief"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "A speculation."@en .
