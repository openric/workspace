#
# The elements a description is made of. Each language value cites one; the element says where it comes from in the ICA standard and which RiC-O or OpenRiC term exports it.

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/description-element/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Description Elements"@en ;
    dcterms:description "Elements of archival description, by source standard element."@en ;
    dcterms:issued "2026-10-19"^^xsd:date ;
    skos:hasTopConcept v:authorised-name, v:other-name, v:history, v:geocultural-context, v:mandates, v:administrative-structure, v:records-policies, v:buildings, v:holdings, v:finding-aids, v:opening-times, v:access-conditions, v:accessibility, v:research-services, v:reproduction-services, v:public-areas, v:rules-conventions, v:description-dates, v:description-sources, v:maintenance-notes .

v:authorised-name a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Authorised form of name"@en ;
    skos:scopeNote "ISDIAH 5.1.2; exported as rico:name."@en ;
    skos:definition "The standardised name of the institution."@en .

v:other-name a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Other form of name"@en ;
    skos:scopeNote "ISDIAH 5.1.3; exported as openricx:otherName."@en ;
    skos:definition "A parallel or other name by which the institution is known."@en .

v:history a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "History"@en ;
    skos:scopeNote "ISDIAH 5.3.1; exported as rico:history."@en ;
    skos:definition "The history of the institution."@en .

v:geocultural-context a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Geographical and cultural context"@en ;
    skos:scopeNote "ISDIAH 5.3.2; exported as openricx:generalContext."@en ;
    skos:definition "The geographical and cultural context of the institution."@en .

v:mandates a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Mandates or sources of authority"@en ;
    skos:scopeNote "ISDIAH 5.3.3."@en ;
    skos:definition "The legal or other sources of the institution's authority."@en .

v:administrative-structure a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Administrative structure"@en ;
    skos:scopeNote "ISDIAH 5.3.4; exported as openricx:hasInternalStructure."@en ;
    skos:definition "How the institution is organised."@en .

v:records-policies a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Records management and collecting policies"@en ;
    skos:scopeNote "ISDIAH 5.3.5; exported as openricx:hasOrHadPolicy."@en ;
    skos:definition "The institution's records management and collecting policies."@en .

v:buildings a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Buildings"@en ;
    skos:scopeNote "ISDIAH 5.3.6."@en ;
    skos:definition "The buildings of the institution and their facilities."@en .

v:holdings a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Archival and other holdings"@en ;
    skos:scopeNote "ISDIAH 5.3.7."@en ;
    skos:definition "A summary of the institution's holdings."@en .

v:finding-aids a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Finding aids, guides and publications"@en ;
    skos:scopeNote "ISDIAH 5.3.8."@en ;
    skos:definition "The finding aids, guides and publications of the institution."@en .

v:opening-times a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Opening times"@en ;
    skos:scopeNote "ISDIAH 5.4.1; exported as openricx:openingHours."@en ;
    skos:definition "When the institution is open to the public."@en .

v:access-conditions a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Conditions and requirements for access"@en ;
    skos:scopeNote "ISDIAH 5.4.2; exported as rico:conditionsOfAccess."@en ;
    skos:definition "What a visitor needs to consult the holdings."@en .

v:accessibility a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Accessibility"@en ;
    skos:scopeNote "ISDIAH 5.4.3; exported as openricx:accessibility."@en ;
    skos:definition "How to reach the institution and the access it offers to people with disabilities."@en .

v:research-services a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Research services"@en ;
    skos:scopeNote "ISDIAH 5.5.1."@en ;
    skos:definition "The research services the institution offers."@en .

v:reproduction-services a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Reproduction services"@en ;
    skos:scopeNote "ISDIAH 5.5.2."@en ;
    skos:definition "The reproduction services the institution offers."@en .

v:public-areas a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Public areas"@en ;
    skos:scopeNote "ISDIAH 5.5.3."@en ;
    skos:definition "The areas of the institution open to the public."@en .

v:rules-conventions a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Rules and conventions"@en ;
    skos:scopeNote "ISDIAH 5.6.3; exported as rico:isOrWasRegulatedBy a rico:Rule."@en ;
    skos:definition "The rules or conventions followed in writing the description."@en .

v:description-dates a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Dates of creation, revision or deletion"@en ;
    skos:scopeNote "ISDIAH 5.6.6."@en ;
    skos:definition "When the description was created, revised or deleted."@en .

v:description-sources a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Sources"@en ;
    skos:scopeNote "ISDIAH 5.6.8; exported as rico:generalDescription."@en ;
    skos:definition "The sources used in writing the description."@en .

v:maintenance-notes a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Maintenance notes"@en ;
    skos:scopeNote "ISDIAH 5.6.9; exported as rico:generalDescription."@en ;
    skos:definition "Notes on how the description was created and maintained."@en .
