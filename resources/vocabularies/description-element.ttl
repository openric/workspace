# OpenRiC Workspace - OpenRiC Workspace Description Elements.
# Copyright (C) 2026 Johan Pieterse / Plain Sailing Information Systems
# SPDX-License-Identifier: AGPL-3.0-or-later
#
# The elements a description is made of. Each language value cites one; the element says where it comes from in the ICA standard and which RiC-O or OpenRiC term exports it.

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/description-element/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Description Elements"@en ;
    dcterms:description "Elements of archival description, grouped under the ICA standard they come from. Only the elements, not the groups, are values of a description."@en ;
    dcterms:issued "2026-10-19"^^xsd:date ;
    skos:hasTopConcept v:isdiah, v:isad-g, v:place, v:isaar-cpf, v:activity .

v:authorised-name a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:isdiah ;
    skos:prefLabel "Authorised form of name"@en ;
    skos:scopeNote "ISDIAH 5.1.2; kept as a rico:AgentName entity of name type authorised, one in each language: a repository is a rico:CorporateBody."@en ;
    skos:definition "The standardised name of the institution."@en .

v:parallel-name a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:isdiah ;
    skos:prefLabel "Parallel form of name"@en ;
    skos:scopeNote "ISDIAH 5.1.3; kept as rico:AgentName entities of name type parallel."@en ;
    skos:definition "The authorised form of name in another language or script, one per line."@en .

v:other-name a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:isdiah ;
    skos:prefLabel "Other form of name"@en ;
    skos:scopeNote "ISDIAH 5.1.4; kept as rico:AgentName entities of name type other."@en ;
    skos:definition "Any other name by which the institution is or was known, such as an abbreviation or an earlier name, one per line."@en .

v:history a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:isdiah ;
    skos:prefLabel "History"@en ;
    skos:scopeNote "ISDIAH 5.3.1; exported as rico:history."@en ;
    skos:definition "The history of the institution."@en .

v:geocultural-context a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:isdiah ;
    skos:prefLabel "Geographical and cultural context"@en ;
    skos:scopeNote "ISDIAH 5.3.2; exported as openricx:generalContext."@en ;
    skos:definition "The geographical and cultural context of the institution."@en .

v:mandates a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:isdiah ;
    skos:prefLabel "Mandates or sources of authority"@en ;
    skos:scopeNote "ISDIAH 5.3.3; exported as rico:authorizingMandate."@en ;
    skos:definition "The legal or other sources of the institution's authority."@en .

v:administrative-structure a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:isdiah ;
    skos:prefLabel "Administrative structure"@en ;
    skos:scopeNote "ISDIAH 5.3.4; exported as openricx:hasInternalStructure."@en ;
    skos:definition "How the institution is organised."@en .

v:records-policies a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:isdiah ;
    skos:prefLabel "Records management and collecting policies"@en ;
    skos:scopeNote "ISDIAH 5.3.5; exported as openricx:hasOrHadPolicy."@en ;
    skos:definition "The institution's records management and collecting policies."@en .

v:buildings a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:isdiah ;
    skos:prefLabel "Buildings"@en ;
    skos:scopeNote "ISDIAH 5.3.6; exported as rico:note, until the buildings are rico:Place entities linked by rico:hasOrHadLocation."@en ;
    skos:definition "The buildings of the institution and their facilities."@en .

v:holdings a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:isdiah ;
    skos:prefLabel "Archival and other holdings"@en ;
    skos:scopeNote "ISDIAH 5.3.7; the narrative, exported as rico:note; each unit held is linked by rico:isOrWasHolderOf."@en ;
    skos:definition "A summary of the institution's holdings."@en .

v:finding-aids a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:isdiah ;
    skos:prefLabel "Finding aids, guides and publications"@en ;
    skos:scopeNote "ISDIAH 5.3.8; the narrative, exported as rico:note; a finding aid described as a unit is linked by rico:isOrWasDescribedBy."@en ;
    skos:definition "The finding aids, guides and publications of the institution."@en .

v:opening-times a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:isdiah ;
    skos:prefLabel "Opening times"@en ;
    skos:scopeNote "ISDIAH 5.4.1; exported as openricx:openingHours."@en ;
    skos:definition "When the institution is open to the public."@en .

v:access-conditions a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:isdiah ;
    skos:prefLabel "Conditions and requirements for access"@en ;
    skos:scopeNote "ISDIAH 5.4.2; exported as rico:conditionsOfAccess."@en ;
    skos:definition "What a visitor needs to consult the holdings."@en .

v:accessibility a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:isdiah ;
    skos:prefLabel "Accessibility"@en ;
    skos:scopeNote "ISDIAH 5.4.3; exported as openricx:accessibility."@en ;
    skos:definition "How to reach the institution and the access it offers to people with disabilities."@en .

v:research-services a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:isdiah ;
    skos:prefLabel "Research services"@en ;
    skos:scopeNote "ISDIAH 5.5.1; exported as rico:note; RiC-O 1.1 has no property for services."@en ;
    skos:definition "The research services the institution offers."@en .

v:reproduction-services a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:isdiah ;
    skos:prefLabel "Reproduction services"@en ;
    skos:scopeNote "ISDIAH 5.5.2; exported as rico:note; RiC-O 1.1 has no property for services."@en ;
    skos:definition "The reproduction services the institution offers."@en .

v:public-areas a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:isdiah ;
    skos:prefLabel "Public areas"@en ;
    skos:scopeNote "ISDIAH 5.5.3; exported as rico:note; RiC-O 1.1 has no property for services."@en ;
    skos:definition "The areas of the institution open to the public."@en .

v:rules-conventions a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:isdiah ;
    skos:prefLabel "Rules and conventions"@en ;
    skos:scopeNote "ISDIAH 5.6.3; exported as rico:isOrWasRegulatedBy a rico:Rule."@en ;
    skos:definition "The rules or conventions followed in writing the description."@en .

v:description-dates a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:isdiah ;
    skos:prefLabel "Dates of creation, revision or deletion"@en ;
    skos:scopeNote "ISDIAH 5.6.6; the dates as written, exported as rico:expressedDate of the rico:Date linked by rico:hasModificationDate."@en ;
    skos:definition "When the description was created, revised or deleted."@en .

v:description-sources a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:isdiah ;
    skos:prefLabel "Sources"@en ;
    skos:scopeNote "ISDIAH 5.6.8; exported as rico:generalDescription."@en ;
    skos:definition "The sources used in writing the description."@en .

v:maintenance-notes a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:isdiah ;
    skos:prefLabel "Maintenance notes"@en ;
    skos:scopeNote "ISDIAH 5.6.9; exported as rico:generalDescription."@en ;
    skos:definition "Notes on how the description was created and maintained."@en .

v:isdiah a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "ISDIAH"@en ;
    skos:definition "Elements of ISDIAH, the International Standard for Describing Institutions with Archival Holdings (2008), used to describe repositories."@en .

v:isad-g a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "ISAD(G)"@en ;
    skos:definition "Elements of ISAD(G), the General International Standard Archival Description (second edition, 2000), used to describe record sets, records and record parts."@en .

v:title a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:isad-g ;
    skos:prefLabel "Title"@en ;
    skos:scopeNote "ISAD(G) 3.1.2; kept as a rico:Title entity of name type authorised, one in each language."@en ;
    skos:definition "The name of the unit of description."@en .

v:dates-expressed a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:isad-g ;
    skos:prefLabel "Dates as written"@en ;
    skos:scopeNote "ISAD(G) 3.1.3, the written form, exported as rico:expressedDate; the structured dates are kept separately as rico:Date entities."@en ;
    skos:definition "The dates of the unit as the archivist writes them, such as circa 1902-1950."@en .

v:extent a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:isad-g ;
    skos:prefLabel "Extent and medium"@en ;
    skos:scopeNote "ISAD(G) 3.1.5; exported as rico:hasExtent, a rico:RecordResourceExtent whose rico:textualValue is the text (mapping 7.1)."@en ;
    skos:definition "The extent and medium of the unit."@en .

v:creator-history a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:isad-g ;
    skos:prefLabel "Administrative or biographical history"@en ;
    skos:scopeNote "ISAD(G) 3.2.2; exported as rico:history of the creator (rico:hasCreator); the authority record of the creator holds it too."@en ;
    skos:definition "The history of the creator, where it is described with the unit."@en .

v:archival-history a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:isad-g ;
    skos:prefLabel "Archival history"@en ;
    skos:scopeNote "ISAD(G) 3.2.3; exported as rico:history."@en ;
    skos:definition "The custodial history of the unit."@en .

v:acquisition a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:isad-g ;
    skos:prefLabel "Immediate source of acquisition or transfer"@en ;
    skos:scopeNote "ISAD(G) 3.2.4; exported as rico:history, after the archival history; the source becomes a relation once accessions are kept."@en ;
    skos:definition "Where and how the unit came to the repository."@en .

v:scope-and-content a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:isad-g ;
    skos:prefLabel "Scope and content"@en ;
    skos:scopeNote "ISAD(G) 3.3.1; exported as rico:scopeAndContent."@en ;
    skos:definition "What the unit is about and what it contains."@en .

v:appraisal a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:isad-g ;
    skos:prefLabel "Appraisal, destruction and scheduling"@en ;
    skos:scopeNote "ISAD(G) 3.3.2; exported as openricx:hasAppraisalInformation."@en ;
    skos:definition "Appraisal decisions and retention schedules."@en .

v:accruals a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:isad-g ;
    skos:prefLabel "Accruals"@en ;
    skos:scopeNote "ISAD(G) 3.3.3; exported as rico:accruals."@en ;
    skos:definition "Expected additions to the unit."@en .

v:arrangement a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:isad-g ;
    skos:prefLabel "System of arrangement"@en ;
    skos:scopeNote "ISAD(G) 3.3.4; exported as rico:structure."@en ;
    skos:definition "How the unit is arranged."@en .

v:conditions-governing-access a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:isad-g ;
    skos:prefLabel "Conditions governing access"@en ;
    skos:scopeNote "ISAD(G) 3.4.1; exported as rico:conditionsOfAccess."@en ;
    skos:definition "The legal or other conditions on access."@en .

v:conditions-governing-reproduction a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:isad-g ;
    skos:prefLabel "Conditions governing reproduction"@en ;
    skos:scopeNote "ISAD(G) 3.4.2; exported as rico:conditionsOfUse."@en ;
    skos:definition "The conditions on reproducing the unit."@en .

v:languages-of-material a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:isad-g ;
    skos:prefLabel "Language/scripts of material"@en ;
    skos:scopeNote "ISAD(G) 3.4.3; the narrative, exported as rico:note until the languages are linked as rico:Language entities (rico:hasOrHadLanguage)."@en ;
    skos:definition "The languages, scripts and symbol systems the material is written in."@en .

v:physical-characteristics a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:isad-g ;
    skos:prefLabel "Physical characteristics and technical requirements"@en ;
    skos:scopeNote "ISAD(G) 3.4.4; exported as rico:physicalCharacteristicsNote."@en ;
    skos:definition "Physical conditions or technical needs that affect use."@en .

v:finding-aids-note a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:isad-g ;
    skos:prefLabel "Finding aids"@en ;
    skos:scopeNote "ISAD(G) 3.4.5; the narrative, exported as rico:note; a finding aid described as a unit is linked by rico:isOrWasDescribedBy."@en ;
    skos:definition "The finding aids that describe the unit."@en .

v:location-of-originals a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:isad-g ;
    skos:prefLabel "Existence and location of originals"@en ;
    skos:scopeNote "ISAD(G) 3.5.1; the narrative, exported as rico:note; an original described as a unit is linked by rico:hasOriginal."@en ;
    skos:definition "Where the originals are, when the unit is a copy."@en .

v:location-of-copies a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:isad-g ;
    skos:prefLabel "Existence and location of copies"@en ;
    skos:scopeNote "ISAD(G) 3.5.2; the narrative, exported as rico:note; a copy described as a unit is linked by rico:hasCopy."@en ;
    skos:definition "Where copies of the unit are."@en .

v:related-units a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:isad-g ;
    skos:prefLabel "Related units of description"@en ;
    skos:scopeNote "ISAD(G) 3.5.3; the narrative, exported as rico:note; each related unit is linked by rico:isRecordResourceAssociatedWithRecordResource."@en ;
    skos:definition "Related material held elsewhere or in the same repository."@en .

v:publication-note a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:isad-g ;
    skos:prefLabel "Publication note"@en ;
    skos:scopeNote "ISAD(G) 3.5.4; exported as openricx:publicationInformation (mapping 7.1)."@en ;
    skos:definition "Publications about or based on the unit."@en .

v:note a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:isad-g ;
    skos:prefLabel "Note"@en ;
    skos:scopeNote "ISAD(G) 3.6.1; exported as rico:generalDescription."@en ;
    skos:definition "Anything that fits no other element."@en .

v:archivists-note a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:isad-g ;
    skos:prefLabel "Archivist's note"@en ;
    skos:scopeNote "ISAD(G) 3.7.1; exported as openricx:descriptiveNote (mapping 7.1)."@en ;
    skos:definition "How the description was prepared and by whom."@en .

v:rules-or-conventions a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:isad-g ;
    skos:prefLabel "Rules or conventions"@en ;
    skos:scopeNote "ISAD(G) 3.7.2; exported as rico:isOrWasRegulatedBy a rico:Rule."@en ;
    skos:definition "The rules the description follows."@en .

v:dates-of-descriptions a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:isad-g ;
    skos:prefLabel "Dates of descriptions"@en ;
    skos:scopeNote "ISAD(G) 3.7.3; the dates as written, exported as rico:expressedDate of the rico:Date linked by rico:hasModificationDate."@en ;
    skos:definition "When the description was prepared or revised."@en .

v:place a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Place"@en ;
    skos:scopeNote "The elements of a place (rico:Place, RiC-CM 1.0). No ICA description standard covers places."@en ;
    skos:definition "The elements a place is described with."@en .

v:place-name a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:place ;
    skos:prefLabel "Authorised name"@en ;
    skos:scopeNote "Kept as a rico:PlaceName entity of name type authorised, one in each language (rico:hasOrHadPlaceName)."@en ;
    skos:definition "The name by which the place is known in this institution's descriptions."@en .

v:place-parallel-name a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:place ;
    skos:prefLabel "Parallel name"@en ;
    skos:scopeNote "Kept as rico:PlaceName entities of name type parallel."@en ;
    skos:definition "The authorised name in another language or script, one per line."@en .

v:place-other-name a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:place ;
    skos:prefLabel "Other name"@en ;
    skos:scopeNote "Kept as rico:PlaceName entities of name type other; the dates each was used are kept with the name."@en ;
    skos:definition "Any other name the place has or had, such as an earlier name, one per line."@en .

v:place-description a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:place ;
    skos:prefLabel "Description"@en ;
    skos:scopeNote "Exported as rico:generalDescription."@en ;
    skos:definition "General information about the place."@en .

v:place-history a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:place ;
    skos:prefLabel "History"@en ;
    skos:scopeNote "Exported as rico:history."@en ;
    skos:definition "How the place developed over time, such as changes of boundary or jurisdiction."@en .

v:isaar-cpf a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "ISAAR(CPF)"@en ;
    skos:scopeNote "International Standard Archival Authority Record for Corporate Bodies, Persons and Families, 2nd edition (ICA, 2004)."@en ;
    skos:definition "The elements of an authority record."@en .

v:agent-authorised-name a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:isaar-cpf ;
    skos:prefLabel "Authorised form(s) of name"@en ;
    skos:scopeNote "ISAAR(CPF) 5.1.2; kept as a rico:AgentName entity of name type authorised, one in each language."@en ;
    skos:definition "The standardised name of the entity, with qualifiers such as dates, place or occupation to tell it from others of the same name."@en .

v:agent-parallel-name a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:isaar-cpf ;
    skos:prefLabel "Parallel forms of name"@en ;
    skos:scopeNote "ISAAR(CPF) 5.1.3; kept as rico:AgentName entities of name type parallel."@en ;
    skos:definition "The authorised form of name in another language or script, one per line."@en .

v:agent-standardised-name a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:isaar-cpf ;
    skos:prefLabel "Standardised forms of name according to other rules"@en ;
    skos:scopeNote "ISAAR(CPF) 5.1.4; kept as rico:AgentName entities of name type standardised."@en ;
    skos:definition "The name as other rules give it, such as those of another agency, one per line."@en .

v:agent-other-name a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:isaar-cpf ;
    skos:prefLabel "Other forms of name"@en ;
    skos:scopeNote "ISAAR(CPF) 5.1.5; kept as rico:AgentName entities of name type other; the dates each was used are kept with the name."@en ;
    skos:definition "Any other name the entity is or was known by, such as a maiden name, a pseudonym or an earlier name of a corporate body, one per line."@en .

v:agent-dates-of-existence a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:isaar-cpf ;
    skos:prefLabel "Dates of existence"@en ;
    skos:scopeNote "ISAAR(CPF) 5.2.1; the dates as written, exported as rico:expressedDate; the normalised existence, birth and death dates are rico:Date entities of the agent."@en ;
    skos:definition "When the entity existed: birth and death, or establishment and dissolution."@en .

v:agent-history a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:isaar-cpf ;
    skos:prefLabel "History"@en ;
    skos:scopeNote "ISAAR(CPF) 5.2.2; exported as rico:history."@en ;
    skos:definition "The main events, activities, achievements and roles of the entity in its life or existence."@en .

v:agent-places a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:isaar-cpf ;
    skos:prefLabel "Places"@en ;
    skos:scopeNote "ISAAR(CPF) 5.2.3; the narrative; each place is a rico:PlaceRelation to a rico:Place. Exported as rico:note."@en ;
    skos:definition "The places and jurisdictions the entity was based in, lived in or connected with, and when."@en .

v:agent-legal-status a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:isaar-cpf ;
    skos:prefLabel "Legal status"@en ;
    skos:scopeNote "ISAAR(CPF) 5.2.4; the narrative; each legal status is a relation to a legal-status concept (rico:hasOrHadLegalStatus). Exported as rico:note."@en ;
    skos:definition "The legal status of a corporate body, with the dates it held."@en .

v:agent-functions a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:isaar-cpf ;
    skos:prefLabel "Functions, occupations and activities"@en ;
    skos:scopeNote "ISAAR(CPF) 5.2.5; the narrative; a person's occupations are relations to occupation types (rico:hasOrHadOccupationOfType, openricx:Occupation). Exported as rico:note."@en ;
    skos:definition "What the entity did: its functions, occupations and activities, with their dates."@en .

v:agent-mandates a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:isaar-cpf ;
    skos:prefLabel "Mandates or sources of authority"@en ;
    skos:scopeNote "ISAAR(CPF) 5.2.6; exported as rico:authorizingMandate."@en ;
    skos:definition "The documents, laws or other sources of the entity's power, functions and responsibilities."@en .

v:agent-internal-structure a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:isaar-cpf ;
    skos:prefLabel "Internal structures or genealogy"@en ;
    skos:scopeNote "ISAAR(CPF) 5.2.7; exported as openricx:hasInternalStructure."@en ;
    skos:definition "The internal structure of a corporate body, or the genealogy of a family."@en .

v:agent-general-context a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:isaar-cpf ;
    skos:prefLabel "General context"@en ;
    skos:scopeNote "ISAAR(CPF) 5.2.8; exported as openricx:generalContext."@en ;
    skos:definition "The social, cultural, economic, political or historical context the entity lived or worked in."@en .

v:agent-institution-identifiers a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:isaar-cpf ;
    skos:prefLabel "Institution identifiers"@en ;
    skos:scopeNote "ISAAR(CPF) 5.4.2; description control, exported as rico:note; the maintaining repository is kept as a link."@en ;
    skos:definition "The agency or agencies responsible for the authority record."@en .

v:agent-rules-conventions a skos:Concept ;
