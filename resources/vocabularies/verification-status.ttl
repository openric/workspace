# Where a verification stands (Heratio's research_verification.status).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/verification-status/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Verification Statuses"@en ;
    dcterms:description "Where a verification stands (Heratio's research_verification.status)."@en ;
    dcterms:issued "2026-10-31"^^xsd:date ;
    skos:hasTopConcept v:pending, v:verified, v:rejected, v:expired .

v:pending a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Pending"@en, "Hangende"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's reading room, as Heratio's ahg-research keeps it."@en ;
    skos:definition "Not yet checked."@en .

v:verified a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Verified"@en, "Bevestig"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's reading room, as Heratio's ahg-research keeps it."@en ;
    skos:definition "Checked and found true."@en .

v:rejected a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Rejected"@en, "Afgekeur"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's reading room, as Heratio's ahg-research keeps it."@en ;
    skos:definition "Checked and not accepted."@en .

v:expired a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Expired"@en, "Verval"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's reading room, as Heratio's ahg-research keeps it."@en ;
    skos:definition "No longer current."@en .
