# The kinds of block a landing page is built from (Heratio's atom_landing_page_block_type).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/landing-block-type/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Landing Page Block Types"@en ;
    dcterms:description "The kinds of block a landing page is built from (Heratio's atom_landing_page_block_type)."@en ;
    dcterms:issued "2026-11-04"^^xsd:date ;
    skos:hasTopConcept v:row-1-col, v:row-2-col, v:row-3-col, v:hero-banner, v:text-content, v:image-carousel, v:search-box, v:statistics, v:browse-panels, v:recent-items, v:holdings-list, v:featured-items, v:repository-spotlight, v:map, v:header-section, v:footer-section, v:quick-links, v:copyright-bar, v:spacer, v:divider .

v:row-1-col a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "1 column row"@en, "Ry met 1 kolom"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's landing pages on its public site, as Heratio's ahg-landing-page keeps them."@en ;
    skos:definition "A row holding blocks in one column."@en .

v:row-2-col a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "2 column row"@en, "Ry met 2 kolomme"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's landing pages on its public site, as Heratio's ahg-landing-page keeps them."@en ;
    skos:definition "A row holding blocks in two columns."@en .

v:row-3-col a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "3 column row"@en, "Ry met 3 kolomme"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's landing pages on its public site, as Heratio's ahg-landing-page keeps them."@en ;
    skos:definition "A row holding blocks in three columns."@en .

