#
# What a request for access covers (Heratio's access_request.scope_type: all, collection, item).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/access-request-scope/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Access Request Scopes"@en ;
    dcterms:description "What the request covers."@en ;
    dcterms:issued "2026-10-28"^^xsd:date ;
    skos:hasTopConcept v:all, v:collection, v:item .

v:all a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Everything"@en ;
    skos:scopeNote "Operational: the handling of a request for access, not part of any RiC description."@en ;
    skos:definition "All holdings available on request that the requester may see."@en .

v:collection a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "A collection"@en ;
    skos:scopeNote "Operational: the handling of a request for access, not part of any RiC description."@en ;
    skos:definition "One collection and everything catalogued inside it."@en .

v:item a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "A single item"@en ;
    skos:scopeNote "Operational: the handling of a request for access, not part of any RiC description."@en ;
    skos:definition "One record only - its children are not included."@en .
