#
# How a file plan import went (Heratio's rm_fileplan_import_session.status).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/file-plan-import-status/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace File Plan Import Statuses"@en ;
    dcterms:description "How a file plan import went (Heratio's rm_fileplan_import_session.status)."@en ;
    dcterms:issued "2026-10-31"^^xsd:date ;
    skos:hasTopConcept v:completed, v:partial, v:failed .

v:completed a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Completed"@en, "Voltooi"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the file plan, as Heratio's ahg-records-manage keeps it."@en ;
    skos:definition "Every node was imported."@en .

v:partial a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Completed with errors"@en, "Voltooi met foute"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the file plan, as Heratio's ahg-records-manage keeps it."@en ;
    skos:definition "Some rows could not be imported."@en .

v:failed a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Failed"@en, "Misluk"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the file plan, as Heratio's ahg-records-manage keeps it."@en ;
    skos:definition "Nothing was imported."@en .
