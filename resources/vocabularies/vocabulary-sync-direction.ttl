# Which way a vocabulary is synchronised with a peer (Heratio's federation_vocab_sync.sync_direction).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/vocabulary-sync-direction/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Vocabulary Sync Directions"@en ;
    dcterms:description "Which way a vocabulary is synchronised with a peer (Heratio's federation_vocab_sync.sync_direction)."@en ;
    dcterms:issued "2026-11-04"^^xsd:date ;
    skos:hasTopConcept v:pull, v:push, v:both .

v:pull a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Pull"@en, "Trek"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's federation with its peers, as Heratio's ahg-federation keeps it."@en ;
    skos:definition "The peer's vocabulary taken into the institution's own."@en .

v:push a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Push"@en, "Stoot"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's federation with its peers, as Heratio's ahg-federation keeps it."@en ;
    skos:definition "The institution's vocabulary offered for the peer to take."@en .

v:both a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Both ways"@en, "Albei rigtings"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's federation with its peers, as Heratio's ahg-federation keeps it."@en ;
    skos:definition "Taken in, and offered."@en .
