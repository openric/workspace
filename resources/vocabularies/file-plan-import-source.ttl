#
# Where an imported file plan came from (Heratio's rm_fileplan_import_session.source_type).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/file-plan-import-source/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace File Plan Import Sources"@en ;
    dcterms:description "Where an imported file plan came from (Heratio's rm_fileplan_import_session.source_type)."@en ;
    dcterms:issued "2026-10-31"^^xsd:date ;
    skos:hasTopConcept v:spreadsheet, v:directory, v:xml .

v:spreadsheet a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Spreadsheet"@en, "Sigblad"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the file plan, as Heratio's ahg-records-manage keeps it."@en ;
    skos:definition "A CSV or Excel sheet, one node a row."@en .

v:directory a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Directory listing"@en, "Gidslys"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the file plan, as Heratio's ahg-records-manage keeps it."@en ;
    skos:definition "A listing of folders, one path a line."@en .

v:xml a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "XML"@en, "XML"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the file plan, as Heratio's ahg-records-manage keeps it."@en ;
    skos:definition "An XML file plan."@en .
