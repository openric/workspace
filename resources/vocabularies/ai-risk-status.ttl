# Where a risk in the register stands (Heratio's ai_risk_register.status, roadmap phase 17f).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/ai-risk-status/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace AI Risk Statuses"@en ;
    dcterms:description "Where a risk in the register stands (Heratio's ai_risk_register.status, roadmap phase 17f)."@en ;
    dcterms:issued "2026-11-08"^^xsd:date ;
    skos:hasTopConcept v:active, v:mitigated, v:accepted, v:closed .

v:active a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Active"@en, "Aktief"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's register of its AI systems, as Heratio's ahg-ai-compliance keeps it (EU AI Act; POPIA's accountability principle in South Africa)."@en ;
    skos:definition "The risk is present and watched."@en .

v:mitigated a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Mitigated"@en, "Versag"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's register of its AI systems, as Heratio's ahg-ai-compliance keeps it (EU AI Act; POPIA's accountability principle in South Africa)."@en ;
    skos:definition "Measures bring it down to its residual level."@en .

v:accepted a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Accepted"@en, "Aanvaar"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's register of its AI systems, as Heratio's ahg-ai-compliance keeps it (EU AI Act; POPIA's accountability principle in South Africa)."@en ;
    skos:definition "Kept at its residual level, knowingly."@en .

v:closed a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Closed"@en, "Gesluit"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's register of its AI systems, as Heratio's ahg-ai-compliance keeps it (EU AI Act; POPIA's accountability principle in South Africa)."@en ;
    skos:definition "No longer a risk."@en .
