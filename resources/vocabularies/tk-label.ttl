<https://localcontexts.org/label/tk-community-use-only/> a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:tk ;
    skos:notation "tk_co" ;
    skos:prefLabel "TK Community Use Only"@en ;
    skos:scopeNote "Exported by its Local Contexts IRI, as a rico:Rule the record is associated with (rico:isAssociatedWithRule), applied by a community."@en ;
    skos:definition "The material is for community use only."@en .

