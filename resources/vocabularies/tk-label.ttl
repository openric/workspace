# The Labels of Local Contexts (localcontexts.org), by their own IRIs, as Heratio's icip_tk_label_type list has them. A community applies a Label to say how its knowledge in a record is to be used.

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/tk-label/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Traditional Knowledge and Biocultural Labels"@en ;
    dcterms:description "The Traditional Knowledge (TK) and Biocultural (BC) Labels of Local Contexts."@en ;
    dcterms:issued "2026-10-27"^^xsd:date ;
    skos:hasTopConcept v:tk, v:bc .

v:tk a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Traditional Knowledge Labels"@en ;
    skos:scopeNote "A group of Local Contexts Labels."@en ;
    skos:definition "The Labels of Local Contexts for Indigenous traditional knowledge."@en .

v:bc a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Biocultural Labels"@en ;
    skos:scopeNote "A group of Local Contexts Labels."@en ;
    skos:definition "The Labels of Local Contexts for Indigenous biocultural rights."@en .

<https://localcontexts.org/label/tk-attribution/> a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:tk ;
    skos:notation "tk_a" ;
    skos:prefLabel "TK Attribution"@en ;
    skos:scopeNote "Exported by its Local Contexts IRI, as a rico:Rule the record is associated with (rico:isAssociatedWithRule), applied by a community."@en ;
    skos:definition "Corrects historical attributions that have not properly attributed Indigenous peoples' contributions to the creation of the material."@en .

<https://localcontexts.org/label/tk-clan/> a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:tk ;
    skos:notation "tk_cl" ;
    skos:prefLabel "TK Clan"@en ;
    skos:scopeNote "Exported by its Local Contexts IRI, as a rico:Rule the record is associated with (rico:isAssociatedWithRule), applied by a community."@en ;
    skos:definition "The material is traditionally and usually owned by clan members."@en .

<https://localcontexts.org/label/tk-family/> a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:tk ;
    skos:notation "tk_f" ;
    skos:prefLabel "TK Family"@en ;
    skos:scopeNote "Exported by its Local Contexts IRI, as a rico:Rule the record is associated with (rico:isAssociatedWithRule), applied by a community."@en ;
    skos:definition "The material is traditionally and usually owned by family members."@en .

<https://localcontexts.org/label/tk-multiple-communities/> a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:tk ;
    skos:notation "tk_mc" ;
    skos:prefLabel "TK Multiple Communities"@en ;
    skos:scopeNote "Exported by its Local Contexts IRI, as a rico:Rule the record is associated with (rico:isAssociatedWithRule), applied by a community."@en ;
    skos:definition "The material traditionally belongs to multiple communities."@en .

<https://localcontexts.org/label/tk-non-commercial/> a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:tk ;
    skos:notation "tk_nc" ;
    skos:prefLabel "TK Non-Commercial"@en ;
    skos:scopeNote "Exported by its Local Contexts IRI, as a rico:Rule the record is associated with (rico:isAssociatedWithRule), applied by a community."@en ;
    skos:definition "The material has specific conditions for commercial use."@en .

<https://localcontexts.org/label/tk-outreach/> a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:tk ;
    skos:notation "tk_o" ;
    skos:prefLabel "TK Outreach"@en ;
    skos:scopeNote "Exported by its Local Contexts IRI, as a rico:Rule the record is associated with (rico:isAssociatedWithRule), applied by a community."@en ;
    skos:definition "There has been community outreach, but no decision has been made."@en .

<https://localcontexts.org/label/tk-secret-sacred/> a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:tk ;
    skos:notation "tk_s" ;
    skos:prefLabel "TK Secret/Sacred"@en ;
    skos:scopeNote "Exported by its Local Contexts IRI, as a rico:Rule the record is associated with (rico:isAssociatedWithRule), applied by a community."@en ;
    skos:definition "The material has specific restrictions around access."@en .

<https://localcontexts.org/label/tk-verified/> a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:tk ;
    skos:notation "tk_v" ;
    skos:prefLabel "TK Verified"@en ;
    skos:scopeNote "Exported by its Local Contexts IRI, as a rico:Rule the record is associated with (rico:isAssociatedWithRule), applied by a community."@en ;
    skos:definition "The community has verified information about the material."@en .

<https://localcontexts.org/label/tk-culturally-sensitive/> a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:tk ;
    skos:notation "tk_cs" ;
    skos:prefLabel "TK Culturally Sensitive"@en ;
    skos:scopeNote "Exported by its Local Contexts IRI, as a rico:Rule the record is associated with (rico:isAssociatedWithRule), applied by a community."@en ;
    skos:definition "The material is culturally sensitive and should be treated accordingly."@en .

<https://localcontexts.org/label/tk-community-voice/> a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:tk ;
    skos:notation "tk_cv" ;
