# Which way a job goes (Heratio's am_job.direction).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/archivematica-direction/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Archivematica Directions"@en ;
    dcterms:description "Which way a job goes (Heratio's am_job.direction)."@en ;
    dcterms:issued "2026-11-04"^^xsd:date ;
    skos:hasTopConcept v:to-archivematica, v:from-archivematica .

v:to-archivematica a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "To Archivematica"@en, "Na Archivematica"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's link to Archivematica, as Heratio's ahg-archivematica keeps it."@en ;
    skos:definition "A unit sent as a transfer."@en .

v:from-archivematica a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "From Archivematica"@en, "Van Archivematica"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's link to Archivematica, as Heratio's ahg-archivematica keeps it."@en ;
    skos:definition "A package fetched from the Storage Service, or deposited by SWORD."@en .
