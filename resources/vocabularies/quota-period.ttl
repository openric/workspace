# Over what time a research quota counts (Heratio's quota_period).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/quota-period/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Quota Periods"@en ;
    dcterms:description "Over what time a research quota counts (Heratio's quota_period)."@en ;
    dcterms:issued "2026-10-31"^^xsd:date ;
    skos:hasTopConcept v:monthly, v:total .

v:monthly a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Per calendar month"@en, "Per kalendermaand"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "Counted afresh each month."@en .

v:total a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "All-time total"@en, "Totaal vir altyd"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "Counted over all time."@en .
