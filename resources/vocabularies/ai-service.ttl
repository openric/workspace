# What a model was asked to do, through the AI gateway (Heratio's ahg_ai_inference.service_name).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/ai-service/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace AI Services"@en ;
    dcterms:description "What a model was asked to do, through the AI gateway (Heratio's ahg_ai_inference.service_name)."@en ;
    dcterms:issued "2026-11-04"^^xsd:date ;
    skos:hasTopConcept v:ocr, v:htr, v:ner, v:summarize, v:translate, v:embed, v:chat, v:annif, v:condition, v:chatbot .

v:ocr a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Reading printed text"@en, "Lees van gedrukte teks"@af ;
    skos:scopeNote "Not a RiC-O term: kept with each call a model answered, in the Workspace's chained and signed log of inferences, as Heratio's ahg-provenance-ai keeps them; exported as the prov:Activity a model output was generated by."@en ;
    skos:definition "A vision model reads the text of a page image, checked against Tesseract."@en .

v:htr a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Reading handwriting"@en, "Lees van handskrif"@af ;
    skos:scopeNote "Not a RiC-O term: kept with each call a model answered, in the Workspace's chained and signed log of inferences, as Heratio's ahg-provenance-ai keeps them; exported as the prov:Activity a model output was generated by."@en ;
    skos:definition "A handwriting model reads a page image."@en .

v:ner a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Finding names"@en, "Vind van name"@af ;
    skos:scopeNote "Not a RiC-O term: kept with each call a model answered, in the Workspace's chained and signed log of inferences, as Heratio's ahg-provenance-ai keeps them; exported as the prov:Activity a model output was generated by."@en ;
    skos:definition "Names of people, organisations, places and dates found in a text."@en .

v:summarize a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Summarising"@en, "Opsomming"@af ;
    skos:scopeNote "Not a RiC-O term: kept with each call a model answered, in the Workspace's chained and signed log of inferences, as Heratio's ahg-provenance-ai keeps them; exported as the prov:Activity a model output was generated by."@en ;
    skos:definition "A summary of a text, as a proposed scope and content."@en .

v:translate a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Translating"@en, "Vertaling"@af ;
    skos:scopeNote "Not a RiC-O term: kept with each call a model answered, in the Workspace's chained and signed log of inferences, as Heratio's ahg-provenance-ai keeps them; exported as the prov:Activity a model output was generated by."@en ;
    skos:definition "A text translated into another language."@en .

v:embed a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Reading for meaning"@en, "Lees vir betekenis"@af ;
    skos:scopeNote "Not a RiC-O term: kept with each call a model answered, in the Workspace's chained and signed log of inferences, as Heratio's ahg-provenance-ai keeps them; exported as the prov:Activity a model output was generated by."@en ;
    skos:definition "A text turned into a vector, for search by meaning."@en .

v:chat a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Answering"@en, "Beantwoording"@af ;
    skos:scopeNote "Not a RiC-O term: kept with each call a model answered, in the Workspace's chained and signed log of inferences, as Heratio's ahg-provenance-ai keeps them; exported as the prov:Activity a model output was generated by."@en ;
    skos:definition "A language model answering a question or a prompt."@en .

v:annif a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Suggesting subjects"@en, "Voorstel van onderwerpe"@af ;
    skos:scopeNote "Not a RiC-O term: kept with each call a model answered, in the Workspace's chained and signed log of inferences, as Heratio's ahg-provenance-ai keeps them; exported as the prov:Activity a model output was generated by."@en ;
    skos:definition "Subjects suggested from a vocabulary by Annif."@en .

v:condition a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Assessing condition"@en, "Beoordeling van toestand"@af ;
    skos:scopeNote "Not a RiC-O term: kept with each call a model answered, in the Workspace's chained and signed log of inferences, as Heratio's ahg-provenance-ai keeps them; exported as the prov:Activity a model output was generated by."@en ;
    skos:definition "A picture of an object assessed for its condition."@en .

v:chatbot a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Answering questions about the catalogue"@en, "Beantwoord vrae oor die katalogus"@af ;
    skos:scopeNote "Not a RiC-O term: kept with each call a model answered, in the Workspace's chained and signed log of inferences, as Heratio's ahg-provenance-ai keeps them."@en ;
    skos:definition "A reader's question answered from the records they may read, citing them, by the catalogue's assistant (phase 17f)."@en .
