#
# What a security compromise affected (POPIA s.22; Heratio's privacy_breach.breach_type).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/breach-type/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Security Compromise Types"@en ;
    dcterms:description "What a security compromise affected (POPIA s.22; Heratio's privacy_breach.breach_type)."@en ;
    dcterms:issued "2026-10-31"^^xsd:date ;
    skos:hasTopConcept v:confidentiality, v:integrity, v:availability .

v:confidentiality a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Confidentiality"@en, "Vertroulikheid"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's privacy registers, as Heratio's ahg-privacy keeps it."@en ;
    skos:definition "Personal information was disclosed to or reached by someone not entitled to it."@en .

v:integrity a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Integrity"@en, "Integriteit"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's privacy registers, as Heratio's ahg-privacy keeps it."@en ;
    skos:definition "Personal information was altered or corrupted."@en .

v:availability a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Availability"@en, "Beskikbaarheid"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's privacy registers, as Heratio's ahg-privacy keeps it."@en ;
    skos:definition "Personal information was lost or made unavailable."@en .
