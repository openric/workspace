#
# Whether an article on the public site is seen by the public (Heratio's blog_post.status).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/site-article-status/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Site Article Statuses"@en ;
    dcterms:description "Whether an article on the public site is seen by the public (Heratio's blog_post.status)."@en ;
    dcterms:issued "2026-11-04"^^xsd:date ;
    skos:hasTopConcept v:draft, v:published .

v:draft a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Draft"@en, "Konsep"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's articles on its public site, as Heratio's ahg-articles keeps them."@en ;
    skos:definition "Kept for the editors; not on the public site."@en .

v:published a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Published"@en, "Gepubliseer"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's articles on its public site, as Heratio's ahg-articles keeps them."@en ;
    skos:definition "On the public site, from its publication date."@en .
