# How a researcher sorts a source of a project (Heratio's research_source_triage.triage_category).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/triage-category/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Source Triage Categories"@en ;
    dcterms:description "How a researcher sorts a source of a project (Heratio's research_source_triage.triage_category)."@en ;
    dcterms:issued "2026-10-31"^^xsd:date ;
    skos:hasTopConcept v:essential, v:useful, v:background, v:contested, v:weak, v:duplicate, v:excluded, v:read-later, v:method-source, v:theory-source, v:evidence-source .

v:essential a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Essential"@en, "Noodsaaklik"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "Cannot do without it."@en .

v:useful a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Useful"@en, "Nuttig"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "Worth using."@en .

v:background a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Background"@en, "Agtergrond"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "For background."@en .

v:contested a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Contested"@en, "Betwis"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "Its standing is disputed."@en .

v:weak a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Weak"@en, "Swak"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "Of little weight."@en .

v:duplicate a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Duplicate"@en, "Duplikaat"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "The same as another."@en .

v:excluded a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Excluded"@en, "Uitgesluit"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "Left out."@en .

v:read-later a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
