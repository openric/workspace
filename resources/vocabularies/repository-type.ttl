# The type of a repository (ISDIAH 5.1.5), AtoM's Repository Types taxonomy (taxonomy 38, as PSIS has it).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/repository-type/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Repository Types"@en ;
    dcterms:description "The type of a repository (ISDIAH 5.1.5), as AtoM lists them."@en ;
    dcterms:issued "2026-10-28"^^xsd:date ;
    skos:hasTopConcept v:international, v:national, v:regional, v:provincial-state, v:community, v:religious, v:university, v:municipal, v:aboriginal, v:educational, v:medical, v:military, v:private .

v:international a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "International"@en ;
    skos:scopeNote "ISDIAH 5.1.5; exported as rico:hasOrHadCorporateBodyType."@en .

