#
# Who may open a folder of favourites (Heratio's favorites_folder.visibility).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/favourite-visibility/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Favourite Folder Visibilities"@en ;
    dcterms:description "Who may open a folder of favourites (Heratio's favorites_folder.visibility)."@en ;
    dcterms:issued "2026-10-31"^^xsd:date ;
    skos:hasTopConcept v:private, v:shared, v:public .

v:private a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Private"@en, "Privaat"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio keeps it."@en ;
    skos:definition "Only its owner."@en .

v:shared a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Shared (link)"@en, "Gedeel (skakel)"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio keeps it."@en ;
    skos:definition "Anyone holding its link, until the link expires."@en .

v:public a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Public"@en, "Publiek"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio keeps it."@en ;
    skos:definition "Anyone holding its link, with no end date."@en .
