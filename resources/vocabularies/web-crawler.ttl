#
# The programs that read the public catalogue automatically, so usage statistics count them apart
# (PSIS ahgStatisticsPlugin, Heratio ahg-statistics: ahg_bot_list, with its categories as the broader
# concepts). Each hidden label is a piece of the user agent that names the program, matched without
# regard to case. GPTBot, ClaudeBot, PerplexityBot, Bytespider, Amazonbot and Applebot are added to
# PSIS's list.

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/web-crawler/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Web Crawlers"@en ;
    dcterms:description "Programs that read the public catalogue automatically, by kind."@en ;
    dcterms:issued "2026-10-28"^^xsd:date ;
    skos:hasTopConcept v:search-engine, v:social, v:monitoring, v:crawler .

v:search-engine a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Search engine"@en ;
    skos:scopeNote "Operational: how usage statistics tell programs from people, not part of any RiC description."@en ;
    skos:definition "A search engine indexing the catalogue."@en .

v:social a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Social media"@en ;
    skos:scopeNote "Operational: how usage statistics tell programs from people, not part of any RiC description."@en ;
    skos:definition "A social media service showing a preview of a shared link."@en .

v:monitoring a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Monitoring"@en ;
    skos:scopeNote "Operational: how usage statistics tell programs from people, not part of any RiC description."@en ;
    skos:definition "A service checking that the site is up."@en .

v:crawler a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Crawler"@en ;
    skos:scopeNote "Operational: how usage statistics tell programs from people, not part of any RiC description."@en ;
    skos:definition "Another program that reads pages automatically, such as an SEO or AI crawler, an archive or a script."@en .

v:googlebot a skos:Concept ;
    skos:inScheme v: ;
    skos:broader v:search-engine ;
    skos:prefLabel "Googlebot"@en ;
    skos:scopeNote "Operational: how usage statistics tell programs from people, not part of any RiC description."@en ;
    skos:hiddenLabel "Googlebot" ;
    skos:hiddenLabel "Google-Site-Verification" .

