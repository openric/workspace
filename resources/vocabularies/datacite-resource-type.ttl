    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Book"@en, "Boek"@af ;
    skos:scopeNote "Not a RiC-O term: DataCite Metadata Schema 4.5 resourceTypeGeneral, given to DataCite with a unit's DOI (roadmap phase 20c)."@en ;
    skos:definition "A book."@en .

