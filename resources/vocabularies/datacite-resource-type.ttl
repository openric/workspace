# The general type of a resource a DOI names (DataCite resourceTypeGeneral).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/datacite-resource-type/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace DataCite Resource Types"@en ;
    dcterms:description "The general type of a resource a DOI names (DataCite resourceTypeGeneral)."@en ;
    dcterms:issued "2026-11-04"^^xsd:date ;
    skos:hasTopConcept v:Audiovisual, v:Book, v:BookChapter, v:Collection, v:ComputationalNotebook, v:ConferencePaper, v:ConferenceProceeding, v:DataPaper, v:Dataset, v:Dissertation, v:Event, v:Image, v:Instrument, v:InteractiveResource, v:Journal, v:JournalArticle, v:Model, v:OutputManagementPlan, v:PeerReview, v:PhysicalObject, v:Preprint, v:Report, v:Service, v:Software, v:Sound, v:Standard, v:StudyRegistration, v:Text, v:Workflow, v:Other .

v:Audiovisual a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Audiovisual"@en, "Oudiovisueel"@af ;
    skos:scopeNote "Not a RiC-O term: DataCite Metadata Schema 4.5 resourceTypeGeneral, given to DataCite with a unit's DOI (roadmap phase 20c)."@en ;
    skos:definition "A series of visual representations, with or without sound."@en .

