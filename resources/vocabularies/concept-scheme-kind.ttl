#
# What the concepts of an institution's own vocabulary are (ADR 0006): each kind names the RiC-O 1.1 class its concepts are exported as and the property that links them.

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/concept-scheme-kind/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Concept Scheme Kinds"@en ;
    dcterms:description "The kinds of vocabulary an institution keeps for its access points and types."@en ;
    dcterms:issued "2026-10-20"^^xsd:date ;
    skos:hasTopConcept v:subject, v:occupation-type, v:place-type, v:documentary-form-type, v:legal-status, v:activity-type, v:container-type, v:storage-place-type, v:level-of-description .

v:subject a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Subjects"@en ;
    skos:scopeNote "Concepts exported as rico:Concept (and skos:Concept); a unit of description is linked to one by rico:hasOrHadSubject."@en ;
    skos:definition "Topics that units of description are about."@en .

v:occupation-type a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Occupation types"@en ;
    skos:scopeNote "Concepts exported as rico:OccupationType; a person is linked to one by rico:hasOrHadOccupationOfType."@en ;
    skos:definition "Professions, trades and crafts pursued by persons."@en .

v:place-type a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Place types"@en ;
    skos:scopeNote "Concepts exported as rico:PlaceType; a place is linked to one by rico:hasOrHadPlaceType."@en ;
    skos:definition "Kinds of place, such as country, province, town or farm."@en .

v:documentary-form-type a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Documentary form types"@en ;
    skos:scopeNote "Concepts exported as rico:DocumentaryFormType; a record or record part is linked to one by rico:hasDocumentaryFormType. AtoM and Heratio call these genres."@en ;
    skos:definition "Kinds of document, such as letters, minutes, maps or photographs."@en .

v:legal-status a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Legal statuses"@en ;
    skos:scopeNote "Concepts exported as rico:LegalStatus; an agent is linked to one by rico:hasOrHadLegalStatus. ISAAR(CPF) 5.2.4."@en ;
    skos:definition "Legal statuses of agents, such as a company, a trust or a statutory body."@en .

v:activity-type a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Activity types"@en ;
    skos:scopeNote "Concepts exported as rico:ActivityType; an activity is linked to one by rico:hasActivityType. The institution's own kinds of activity, such as marriage, beside the OpenRiC activity-type vocabulary (mapping section 6.5)."@en ;
    skos:definition "Kinds of activity, such as marriage or appointment."@en .

v:container-type a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Container types"@en ;
    skos:scopeNote "Concepts exported as openricx:ContainerType (extension ontology 1.6.0); a container is linked to one by openricx:hasContainerType. They add to the bundled container-type vocabulary."@en ;
    skos:definition "Kinds of storage container, such as box, folder or map drawer."@en .

v:storage-place-type a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Storage place types"@en ;
    skos:scopeNote "Concepts exported as rico:PlaceType; a storage place is linked to one by rico:hasOrHadPlaceType. They add to the bundled storage-place-type vocabulary, and a place of one of these types is a storage place."@en ;
    skos:definition "Kinds of place in which containers are kept, such as strongroom, aisle or shelf."@en .

v:level-of-description a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Levels of description"@en ;
    skos:scopeNote "The institution's own levels, beside the bundled level-of-description vocabulary (ISAD(G) 3.1.4), as AtoM's levels of description taxonomy allows. Each level's scope note names what its units are, rico:RecordSet, rico:Record or rico:RecordPart (rico:RecordResource where it names none); a record set is linked to its level by rico:hasRecordSetType, and EAD carries the level as otherlevel."@en ;
    skos:definition "Levels of arrangement an institution uses that the bundled list does not have, such as volume or document."@en .
