    skos:scopeNote "Exported as MODS typeOfResource; not exported in RiC, which keeps no such list."@en .

v:still-image a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "still image"@en, "stilbeeld"@af ;
    skos:scopeNote "Exported as MODS typeOfResource; not exported in RiC, which keeps no such list."@en .

v:moving-image a skos:Concept ;
    skos:inScheme v: ;
