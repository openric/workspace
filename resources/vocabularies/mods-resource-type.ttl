# MODS typeOfResource values, AtoM's MODS resource type taxonomy (Heratio's modsTypeIds).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/mods-resource-type/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace MODS Types of Resource"@en ;
    dcterms:description "MODS typeOfResource values, AtoM's MODS resource type taxonomy (Heratio's modsTypeIds)."@en ;
    dcterms:issued "2026-10-29"^^xsd:date ;
    skos:hasTopConcept v:text, v:cartographic, v:notated-music, v:sound-recording, v:sound-recording-musical, v:sound-recording-nonmusical, v:still-image, v:moving-image, v:three-dimensional-object, v:software-multimedia, v:mixed-material .

v:text a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "text"@en, "teks"@af ;
    skos:scopeNote "Exported as MODS typeOfResource; not exported in RiC, which keeps no such list."@en .

v:cartographic a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "cartographic"@en, "kartografies"@af ;
    skos:scopeNote "Exported as MODS typeOfResource; not exported in RiC, which keeps no such list."@en .

v:notated-music a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "notated music"@en, "genoteerde musiek"@af ;
    skos:scopeNote "Exported as MODS typeOfResource; not exported in RiC, which keeps no such list."@en .

