# How near a source is to what it tells of (Heratio's research_source_assessment.source_type).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/source-kind/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Source Kinds"@en ;
    dcterms:description "How near a source is to what it tells of (Heratio's research_source_assessment.source_type)."@en ;
    dcterms:issued "2026-10-31"^^xsd:date ;
    skos:hasTopConcept v:primary, v:secondary, v:tertiary .

v:primary a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Primary"@en, "Primêr"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "Made at the time, by those involved."@en .

v:secondary a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Secondary"@en, "Sekondêr"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "Written later, from primary sources."@en .

v:tertiary a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Tertiary"@en, "Tersiêr"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "Drawn from secondary sources."@en .
