# What a step asks of whoever does it (Heratio's workflow_action_required).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/workflow-action/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Workflow Step Actions"@en ;
    dcterms:description "What a step asks of whoever does it (Heratio's workflow_action_required)."@en ;
    dcterms:issued "2026-10-29"^^xsd:date ;
    skos:hasTopConcept v:approve-reject, v:acknowledge, v:review-only .

v:approve-reject a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Approve / Reject"@en, "Goedkeur / Afkeur"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the workflow, as Heratio's ahg-workflow keeps it."@en ;
    skos:definition "Approve it, reject it or return it."@en .

v:acknowledge a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Acknowledge"@en, "Erken"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the workflow, as Heratio's ahg-workflow keeps it."@en ;
    skos:definition "Acknowledge it."@en .

v:review-only a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Review Only"@en, "Slegs hersien"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the workflow, as Heratio's ahg-workflow keeps it."@en ;
    skos:definition "Review it, with no decision."@en .
