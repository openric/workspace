#
# What the institution does with files of a format (Heratio's preservation_format.preservation_action).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/format-action/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Format Preservation Actions"@en ;
    dcterms:description "What the institution does with files of a format (Heratio's preservation_format.preservation_action)."@en ;
    dcterms:issued "2026-11-03"^^xsd:date ;
    skos:hasTopConcept v:none, v:monitor, v:migrate, v:normalise .

v:none a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "None"@en, "Geen"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's preservation planning, as Heratio's ahg-preservation keeps it."@en ;
    skos:definition "Kept as it is."@en .

v:monitor a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Monitor"@en, "Monitor"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's preservation planning, as Heratio's ahg-preservation keeps it."@en ;
    skos:definition "Kept, and watched for obsolescence."@en .

v:migrate a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Migrate"@en, "Migreer"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's preservation planning, as Heratio's ahg-preservation keeps it."@en ;
    skos:definition "Its files to be carried into another format."@en .

v:normalise a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Normalise"@en, "Normaliseer"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's preservation planning, as Heratio's ahg-preservation keeps it."@en ;
    skos:definition "A preservation copy to be made in a preferred format."@en .
