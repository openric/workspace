# What a migration pathway loses of its source (Heratio's preservation_migration_pathway.quality_impact).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/migration-quality-impact/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Migration Quality Impacts"@en ;
    dcterms:description "What a migration pathway loses of its source (Heratio's preservation_migration_pathway.quality_impact)."@en ;
    dcterms:issued "2026-11-04"^^xsd:date ;
    skos:hasTopConcept v:lossless, v:minimal, v:moderate, v:significant .

v:lossless a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Lossless"@en, "Verliesloos"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's preservation planning, as Heratio's ahg-preservation keeps it."@en ;
    skos:definition "Nothing is lost."@en .

v:minimal a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Minimal"@en, "Minimaal"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's preservation planning, as Heratio's ahg-preservation keeps it."@en ;
    skos:definition "Little is lost, and nothing of the content."@en .

v:moderate a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Moderate"@en, "Matig"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's preservation planning, as Heratio's ahg-preservation keeps it."@en ;
    skos:definition "Some appearance or behaviour is lost."@en .

v:significant a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Significant"@en, "Beduidend"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's preservation planning, as Heratio's ahg-preservation keeps it."@en ;
    skos:definition "Much is lost: keep the source."@en .
