#
# The status of a description, as the ICA standards record it in their control area (ISDIAH 5.6.4, ISAAR(CPF) 5.4.4, ISDF 5.4.4).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/description-status/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Description Status"@en ;
    dcterms:description "Status of an archival description."@en ;
    dcterms:issued "2026-10-20"^^xsd:date ;
    skos:hasTopConcept v:draft, v:revised, v:final .

v:draft a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Draft"@en ;
    skos:scopeNote "ISDIAH 5.6.4."@en ;
    skos:definition "The description is being written."@en .

v:revised a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Revised"@en ;
    skos:scopeNote "ISDIAH 5.6.4."@en ;
    skos:definition "The description has been revised since it was finished."@en .

v:final a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Final"@en ;
    skos:scopeNote "ISDIAH 5.6.4."@en ;
    skos:definition "The description is finished."@en .
