# What a harvest did with one record (Heratio's federation_harvest_log.action).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/harvest-action/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Harvest Actions"@en ;
    dcterms:description "What a harvest did with one record (Heratio's federation_harvest_log.action)."@en ;
    dcterms:issued "2026-11-04"^^xsd:date ;
    skos:hasTopConcept v:created, v:updated, v:deleted, v:skipped .

v:created a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Created"@en, "Geskep"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's federation with its peers, as Heratio's ahg-federation keeps it."@en ;
    skos:definition "Taken in as a new draft unit of description."@en .

v:updated a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Updated"@en, "Bygewerk"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's federation with its peers, as Heratio's ahg-federation keeps it."@en ;
    skos:definition "The unit taken in before, brought up to date."@en .

v:deleted a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Deleted"@en, "Geskrap"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's federation with its peers, as Heratio's ahg-federation keeps it."@en ;
    skos:definition "The peer deleted it, so the unit taken in from it is marked deleted."@en .

v:skipped a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Skipped"@en, "Oorgeslaan"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's federation with its peers, as Heratio's ahg-federation keeps it."@en ;
    skos:definition "Nothing to take in, or not a unit the harvest made."@en .
