#
# What kind of copy is made (Heratio's research_reproduction_item.reproduction_type and its prices).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/reproduction-type/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Reproduction Types"@en ;
    dcterms:description "What kind of copy is made (Heratio's research_reproduction_item.reproduction_type and its prices)."@en ;
    dcterms:issued "2026-10-31"^^xsd:date ;
    skos:hasTopConcept v:photocopy, v:scan, v:photograph, v:digital-copy, v:transcription, v:certification .

v:photocopy a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Photocopy"@en, "Fotostaat"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "A paper copy, priced by the page."@en .

v:scan a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Scan"@en, "Skandering"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "A scanned image, priced by the page."@en .

v:photograph a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Photograph"@en, "Foto"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "A photograph, priced by the image."@en .

v:digital-copy a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Digital copy"@en, "Digitale afskrif"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "A copy of a digital file, priced by the file."@en .

v:transcription a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Transcription"@en, "Transkripsie"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "A typed transcription, priced by the page."@en .

v:certification a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Certification"@en, "Sertifisering"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "A certified copy, priced by the document."@en .
