#
# What an account may do. Code checks a permission IRI; which roles hold it is data. Anything not granted is denied.

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/permission/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Permissions"@en ;
    dcterms:description "Actions that require a permission. Access is denied unless one of the account roles is granted the permission."@en ;
    dcterms:issued "2026-10-19"^^xsd:date ;
    skos:hasTopConcept v:manage-institution, v:manage-accounts, v:view-audit-log, v:describe, v:review, v:publish .

v:manage-institution a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Manage institution"@en ;
    skos:definition "Change the institution settings."@en .

v:manage-accounts a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Manage accounts"@en ;
    skos:definition "Create accounts, change them, and grant or revoke roles."@en .

v:view-audit-log a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "View audit log"@en ;
    skos:definition "Read the audit log of the institution."@en .

v:describe a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Describe"@en ;
    skos:definition "Create and edit descriptions, relations and their evidence."@en .

v:review a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Review"@en ;
    skos:definition "Approve or return described material."@en .

v:publish a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Publish"@en ;
    skos:definition "Publish or withdraw approved material."@en .
