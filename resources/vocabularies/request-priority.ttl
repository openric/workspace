#
# How soon a request is to be met (Heratio's research_material_request.priority).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/request-priority/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Request Priorities"@en ;
    dcterms:description "How soon a request is to be met (Heratio's research_material_request.priority)."@en ;
    dcterms:issued "2026-10-31"^^xsd:date ;
    skos:hasTopConcept v:normal, v:high, v:rush .

v:normal a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Normal"@en, "Normaal"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's reading room, as Heratio's ahg-research keeps it."@en ;
    skos:definition "In its turn."@en .

v:high a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "High"@en, "Hoog"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's reading room, as Heratio's ahg-research keeps it."@en ;
    skos:definition "Before normal requests."@en .

v:rush a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Rush"@en, "Dringend"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's reading room, as Heratio's ahg-research keeps it."@en ;
    skos:definition "At once."@en .
