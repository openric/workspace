#
# How a harvest of a peer ended (Heratio's federation_harvest_session.status and federation_peer.last_harvest_status).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/harvest-status/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Harvest Statuses"@en ;
    dcterms:description "How a harvest of a peer ended (Heratio's federation_harvest_session.status and federation_peer.last_harvest_status)."@en ;
    dcterms:issued "2026-11-04"^^xsd:date ;
    skos:hasTopConcept v:running, v:success, v:partial, v:failed .

v:running a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Running"@en, "Aan die gang"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's federation with its peers, as Heratio's ahg-federation keeps it."@en ;
    skos:definition "Being harvested."@en .

v:success a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Success"@en, "Sukses"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's federation with its peers, as Heratio's ahg-federation keeps it."@en ;
    skos:definition "Every record taken in."@en .

v:partial a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Partial"@en, "Gedeeltelik"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's federation with its peers, as Heratio's ahg-federation keeps it."@en ;
    skos:definition "Done, with records that could not be taken in."@en .

v:failed a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Failed"@en, "Misluk"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's federation with its peers, as Heratio's ahg-federation keeps it."@en ;
    skos:definition "The peer could not be harvested; the reason is kept."@en .
