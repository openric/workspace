#
# Whether the files of an instantiation are delivered (WS-007); the read permissions of the unit of description then decide to whom.

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/file-availability/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace File Availability"@en ;
    dcterms:description "Whether the files of an instantiation are delivered."@en ;
    dcterms:issued "2026-10-20"^^xsd:date ;
    skos:hasTopConcept v:online, v:on-request, v:withdrawn .

v:online a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Online"@en ;
    skos:scopeNote "The files are delivered to whoever the unit's read-master, read-reference and read-thumbnail permissions allow. Exported as rico:conditionsOfAccess."@en ;
    skos:definition "Delivered as the permissions allow."@en .

v:on-request a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "On request"@en ;
    skos:scopeNote "The files are delivered only to those who may update the unit; others see that the instantiation exists. Exported as rico:conditionsOfAccess."@en ;
    skos:definition "Kept back; delivered to staff only."@en .

v:withdrawn a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Withdrawn"@en ;
    skos:scopeNote "No file is delivered, to anyone, until the availability changes. Exported as rico:conditionsOfAccess."@en ;
    skos:definition "Not delivered to anyone."@en .
