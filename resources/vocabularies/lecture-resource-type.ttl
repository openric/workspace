#
# What a resource of a lecture is (Heratio's ResearchLectureService::RESOURCE_TYPES).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/lecture-resource-type/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Lecture Resource Types"@en ;
    dcterms:description "What a resource of a lecture is (Heratio's ResearchLectureService::RESOURCE_TYPES)."@en ;
    dcterms:issued "2026-10-31"^^xsd:date ;
    skos:hasTopConcept v:reading, v:slides, v:video, v:link, v:file .

v:reading a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Reading"@en, "Leesstof"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "Something to read."@en .

v:slides a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Slides"@en, "Skyfies"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "The slides."@en .

v:video a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Video"@en, "Video"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "A video."@en .

v:link a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Link"@en, "Skakel"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "A web page."@en .

v:file a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "File"@en, "Lêer"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "A file."@en .
