#
# Whether a node of a file plan takes records (Heratio's rm_fileplan_node.status).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/file-plan-status/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace File Plan Node Statuses"@en ;
    dcterms:description "Whether a node of a file plan takes records (Heratio's rm_fileplan_node.status)."@en ;
    dcterms:issued "2026-10-31"^^xsd:date ;
    skos:hasTopConcept v:active, v:closed .

v:active a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Active"@en, "Aktief"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the file plan, as Heratio's ahg-records-manage keeps it."@en ;
    skos:definition "Records may be placed in it."@en .

v:closed a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Closed"@en, "Gesluit"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the file plan, as Heratio's ahg-records-manage keeps it."@en ;
    skos:definition "It takes no more records."@en .
