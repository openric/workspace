# Where a transfer to Archivematica, or a package from it, stands (Heratio's am_job.status).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/archivematica-job-status/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Archivematica Job Statuses"@en ;
    dcterms:description "Where a transfer to Archivematica, or a package from it, stands (Heratio's am_job.status)."@en ;
    dcterms:issued "2026-11-04"^^xsd:date ;
    skos:hasTopConcept v:pending, v:processing, v:complete, v:failed .

v:pending a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Pending"@en, "Hangende"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's link to Archivematica, as Heratio's ahg-archivematica keeps it."@en ;
    skos:definition "Waiting to be sent or fetched."@en .

v:processing a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Processing"@en, "Word verwerk"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's link to Archivematica, as Heratio's ahg-archivematica keeps it."@en ;
    skos:definition "Archivematica is working on it."@en .

v:complete a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Complete"@en, "Voltooi"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's link to Archivematica, as Heratio's ahg-archivematica keeps it."@en ;
    skos:definition "Archivematica stored it."@en .

v:failed a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Failed"@en, "Misluk"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's link to Archivematica, as Heratio's ahg-archivematica keeps it."@en ;
    skos:definition "It failed; the reason is kept."@en .
