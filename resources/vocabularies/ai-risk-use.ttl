#
# Whether a risk comes from the intended use of an AI system or from misuse that can be foreseen (Heratio's ai_risk_register.intended_or_misuse, roadmap phase 17f).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/ai-risk-use/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace AI Risk Uses"@en ;
    dcterms:description "Whether a risk comes from the intended use of an AI system or from misuse that can be foreseen (Heratio's ai_risk_register.intended_or_misuse, roadmap phase 17f)."@en ;
    dcterms:issued "2026-11-08"^^xsd:date ;
    skos:hasTopConcept v:intended, v:misuse .

v:intended a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Intended use"@en, "Bedoelde gebruik"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's register of its AI systems, as Heratio's ahg-ai-compliance keeps it (EU AI Act; POPIA's accountability principle in South Africa)."@en ;
    skos:definition "Arises when the system is used as intended."@en .

v:misuse a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Foreseeable misuse"@en, "Voorsienbare misbruik"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's register of its AI systems, as Heratio's ahg-ai-compliance keeps it (EU AI Act; POPIA's accountability principle in South Africa)."@en ;
    skos:definition "Arises when the system is used in a way it is not meant for, but that can be foreseen."@en .
