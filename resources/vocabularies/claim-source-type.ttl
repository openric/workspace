#
# What a piece of evidence for a claim or hypothesis is (Heratio's research_assertion_evidence.source_type).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/claim-source-type/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Claim Evidence Sources"@en ;
    dcterms:description "What a piece of evidence for a claim or hypothesis is (Heratio's research_assertion_evidence.source_type)."@en ;
    dcterms:issued "2026-10-31"^^xsd:date ;
    skos:hasTopConcept v:record, v:collection-item, v:annotation, v:bibliography, v:bibliography-entry, v:claim .

v:record a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Record"@en, "Rekord"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "A record of the catalogue."@en .

v:collection-item a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Collection item"@en, "Versamelingsitem"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "An item of one of the researcher's collections."@en .

v:annotation a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Annotation"@en, "Annotasie"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "One of the researcher's annotations."@en .

v:bibliography a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Bibliography"@en, "Bibliografie"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "One of the researcher's bibliographies."@en .

v:bibliography-entry a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Bibliography entry"@en, "Bibliografie-inskrywing"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "A work in one of the researcher's bibliographies."@en .

v:claim a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Claim"@en, "Bewering"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "Another claim."@en .
