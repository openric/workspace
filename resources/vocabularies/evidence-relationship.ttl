# What a piece of evidence does for a claim (Heratio's research_assertion_evidence.relationship).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/evidence-relationship/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Evidence Relationships"@en ;
    dcterms:description "What a piece of evidence does for a claim (Heratio's research_assertion_evidence.relationship)."@en ;
    dcterms:issued "2026-10-31"^^xsd:date ;
    skos:hasTopConcept v:supports, v:refutes .

v:supports a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Supports"@en, "Steun"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "It bears the claim out."@en .

v:refutes a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Refutes"@en, "Weerlê"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "It goes against the claim."@en .
