# What a research permit opens (Heratio's naz_research_permit.permit_type).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/naz-permit-type/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace NAZ Research Permit Types"@en ;
    dcterms:description "What a research permit opens (Heratio's naz_research_permit.permit_type)."@en ;
    dcterms:issued "2026-10-31"^^xsd:date ;
    skos:hasTopConcept v:general, v:restricted, v:special .

v:general a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "General"@en, "Algemeen"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the records of the National Archives of Zimbabwe Act [Chapter 25:06], as Heratio's ahg-naz keeps it."@en ;
    skos:definition "Open records."@en .

v:restricted a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Restricted"@en, "Beperk"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the records of the National Archives of Zimbabwe Act [Chapter 25:06], as Heratio's ahg-naz keeps it."@en ;
    skos:definition "Records with restrictions, as the permit names them."@en .

v:special a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Special"@en, "Spesiaal"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the records of the National Archives of Zimbabwe Act [Chapter 25:06], as Heratio's ahg-naz keeps it."@en ;
    skos:definition "By special approval."@en .
