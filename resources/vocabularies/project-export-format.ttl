#
# How a research project was exported (Heratio's research_export_log.format).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/project-export-format/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Research Project Export Formats"@en ;
    dcterms:description "How a research project was exported (Heratio's research_export_log.format)."@en ;
    dcterms:issued "2026-10-31"^^xsd:date ;
    skos:hasTopConcept v:zip, v:markdown, v:json, v:bibtex, v:ris, v:csl .

v:zip a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "ZIP bundle"@en, "ZIP-bundel"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "Everything, as a ZIP file."@en .

v:markdown a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Markdown"@en, "Markdown"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "The project as Markdown."@en .

v:json a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "JSON"@en, "JSON"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "The project as JSON."@en .

v:bibtex a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "BibTeX"@en, "BibTeX"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "Its sources as BibTeX."@en .

v:ris a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "RIS"@en, "RIS"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "Its sources as RIS."@en .

v:csl a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "CSL-JSON"@en, "CSL-JSON"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "Its sources as CSL-JSON."@en .
