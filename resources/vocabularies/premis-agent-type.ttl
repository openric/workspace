# Who or what carried out an event (Heratio's preservation_event.linking_agent_type; the Library of Congress preservation vocabulary).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/premis-agent-type/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace PREMIS Agent Types"@en ;
    dcterms:description "Who or what carried out an event (Heratio's preservation_event.linking_agent_type; the Library of Congress preservation vocabulary)."@en ;
    dcterms:issued "2026-11-03"^^xsd:date ;
    skos:hasTopConcept v:person, v:organization, v:software .

v:person a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Person"@en, "Persoon"@af ;
    skos:exactMatch <http://id.loc.gov/vocabulary/preservation/agentType/per> ;
    skos:scopeNote "Not a RiC-O term: a PREMIS 3 event type, exported in PREMIS with the Library of Congress preservation vocabulary term it matches."@en ;
    skos:definition "A person."@en .

v:organization a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Organisation"@en, "Organisasie"@af ;
    skos:exactMatch <http://id.loc.gov/vocabulary/preservation/agentType/org> ;
    skos:scopeNote "Not a RiC-O term: a PREMIS 3 event type, exported in PREMIS with the Library of Congress preservation vocabulary term it matches."@en ;
    skos:definition "An organisation."@en .

v:software a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Software"@en, "Sagteware"@af ;
    skos:exactMatch <http://id.loc.gov/vocabulary/preservation/agentType/sof> ;
    skos:scopeNote "Not a RiC-O term: a PREMIS 3 event type, exported in PREMIS with the Library of Congress preservation vocabulary term it matches."@en ;
    skos:definition "A program."@en .
