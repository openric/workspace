#
# What a lecture is (Heratio's ResearchLectureService::TYPES).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/lecture-type/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Lecture Types"@en ;
    dcterms:description "What a lecture is (Heratio's ResearchLectureService::TYPES)."@en ;
    dcterms:issued "2026-10-31"^^xsd:date ;
    skos:hasTopConcept v:curriculum, v:talk, v:standalone .

v:curriculum a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Curriculum lecture"@en, "Kurrikulumlesing"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "Part of a course of training."@en .

v:talk a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Talk"@en, "Praatjie"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "A talk given once."@en .

v:standalone a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Standalone"@en, "Losstaande"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "A lecture on its own."@en .
