#
# What an item of a research notebook is (Heratio's research_notebook_item.item_type).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/notebook-item-type/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Notebook Item Types"@en ;
    dcterms:description "What an item of a research notebook is (Heratio's research_notebook_item.item_type)."@en ;
    dcterms:issued "2026-10-31"^^xsd:date ;
    skos:hasTopConcept v:note, v:source-pin, v:saved-query, v:ai-output .

v:note a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Note"@en, "Nota"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "A note of the researcher."@en .

v:source-pin a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Source"@en, "Bron"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "A record pinned to the notebook."@en .

v:saved-query a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Saved search"@en, "Gestoorde soektog"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "One of the researcher's saved searches."@en .

v:ai-output a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "AI output"@en, "KI-uitvoer"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio's ahg-research keeps it."@en ;
    skos:definition "What an AI service gave the researcher; written by the AI services of phase 17."@en .
