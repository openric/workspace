#
# Where an application for a permit to export heritage objects (NHRA s.32) stands (PSIS's sahra_permit.status).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/export-permit-status/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Export Permit Statuses"@en ;
    dcterms:description "Where an application for a permit to export heritage objects (NHRA s.32) stands (PSIS's sahra_permit.status)."@en ;
    dcterms:issued "2026-10-31"^^xsd:date ;
    skos:hasTopConcept v:draft, v:pending-approval, v:approved, v:returned, v:submitted, v:issued, v:declined, v:expired, v:revoked, v:closed .

v:draft a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Draft"@en, "Konsep"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the export permit under the National Heritage Resources Act, 1999, as PSIS's ahgSAHRAPlugin keeps it."@en ;
    skos:definition "Being written."@en .

v:pending-approval a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Awaiting approval"@en, "Wag op goedkeuring"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the export permit under the National Heritage Resources Act, 1999, as PSIS's ahgSAHRAPlugin keeps it."@en ;
    skos:definition "With the institution, before it goes to the heritage authority."@en .

v:approved a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Approved by the institution"@en, "Deur die instelling goedgekeur"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the export permit under the National Heritage Resources Act, 1999, as PSIS's ahgSAHRAPlugin keeps it."@en ;
    skos:definition "Ready to submit."@en .

v:returned a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Returned by the institution"@en, "Deur die instelling teruggestuur"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the export permit under the National Heritage Resources Act, 1999, as PSIS's ahgSAHRAPlugin keeps it."@en ;
    skos:definition "Sent back to the applicant."@en .

v:submitted a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Submitted"@en, "Ingedien"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the export permit under the National Heritage Resources Act, 1999, as PSIS's ahgSAHRAPlugin keeps it."@en ;
    skos:definition "With the heritage authority."@en .

v:issued a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Permit issued"@en, "Permit uitgereik"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the export permit under the National Heritage Resources Act, 1999, as PSIS's ahgSAHRAPlugin keeps it."@en ;
    skos:definition "The authority issued the permit."@en .

v:declined a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Declined"@en, "Afgewys"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the export permit under the National Heritage Resources Act, 1999, as PSIS's ahgSAHRAPlugin keeps it."@en ;
    skos:definition "The authority declined it."@en .

v:expired a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Expired"@en, "Verval"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the export permit under the National Heritage Resources Act, 1999, as PSIS's ahgSAHRAPlugin keeps it."@en ;
    skos:definition "Its period has ended."@en .

v:revoked a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Revoked"@en, "Herroep"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the export permit under the National Heritage Resources Act, 1999, as PSIS's ahgSAHRAPlugin keeps it."@en ;
    skos:definition "The authority withdrew it."@en .

v:closed a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Closed"@en, "Gesluit"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the export permit under the National Heritage Resources Act, 1999, as PSIS's ahgSAHRAPlugin keeps it."@en ;
    skos:definition "The objects have come back, or the permit was not used."@en .
