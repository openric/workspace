# Where feedback stands (Heratio's feedback_i18n.status).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/feedback-status/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Feedback Statuses"@en ;
    dcterms:description "Where feedback stands (Heratio's feedback_i18n.status)."@en ;
    dcterms:issued "2026-10-31"^^xsd:date ;
    skos:hasTopConcept v:pending, v:completed .

v:pending a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Pending"@en, "Hangende"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio keeps it."@en ;
    skos:definition "Received, not yet dealt with."@en .

v:completed a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Completed"@en, "Voltooi"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the institution's research services, as Heratio keeps it."@en ;
    skos:definition "Dealt with."@en .
