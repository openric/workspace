# What happened to an accession and when (AtoM's accession event type taxonomy and the CAAIS 5.1.1 event types Heratio offers).

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix v:       <https://workspace.openric.org/vocab/accession-event-type/> .

v: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Workspace Accession Event Types"@en ;
    dcterms:description "What happened to an accession and when (AtoM's accession event type taxonomy and the CAAIS 5.1.1 event types Heratio offers)."@en ;
    dcterms:issued "2026-10-29"^^xsd:date ;
    skos:hasTopConcept v:physical-transfer, v:legal-transfer, v:deed-of-gift-signed, v:transfer-agreement-signed, v:ceremonial-protocol, v:reboxing-started, v:reboxing-completed, v:archival-appraisal, v:disk-image-created, v:checksums-created, v:deaccessioned .

v:physical-transfer a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Physical transfer"@en, "Fisiese oordrag"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the accession, as AtoM and Heratio keep it; given in the CAAIS export."@en .

v:legal-transfer a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Legal transfer"@en, "Regsoordrag"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the accession, as AtoM and Heratio keep it; given in the CAAIS export."@en .

v:deed-of-gift-signed a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
    skos:prefLabel "Deed of gift signed"@en, "Skenkingsakte onderteken"@af ;
    skos:scopeNote "Not a RiC-O term: kept with the accession, as AtoM and Heratio keep it; given in the CAAIS export."@en .

v:transfer-agreement-signed a skos:Concept ;
    skos:inScheme v: ;
    skos:topConceptOf v: ;
