# OpenRiC Date-Type Vocabulary
# SKOS ConceptScheme of date-type concepts referenced from rico:hasDateType
# on rico:Date (and openricx:DateRange, a subclass of rico:Date) in
# OpenRiC-conformant graphs. See spec/mapping.html section 7.2.

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix rico:    <https://www.ica.org/standards/RiC/ontology#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dt:      <https://openric.org/vocab/date-type/> .

dt: a skos:ConceptScheme ;
    dcterms:title "OpenRiC Date-Type Vocabulary"@en ;
    dcterms:description "SKOS ConceptScheme of date-type concepts referenced from rico:hasDateType. Each concept is also a rico:DateType, the RiC-O 1.1 class that rico:hasDateType points to. RiC-O 1.1 defines the class but publishes no date-type vocabulary."@en ;
    dcterms:issued "2026-10-19"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    skos:hasTopConcept dt:existence, dt:creation, dt:accumulation, dt:descriptive, dt:custody .

dt:existence a skos:Concept, rico:DateType ;
    skos:inScheme dt: ;
    skos:topConceptOf dt: ;
    skos:prefLabel "Existence"@en, "Existence"@fr, "Existencia"@es ;
    skos:definition "The dates during which an agent existed, or during which a function was carried out."@en ;
    skos:scopeNote "Source element: ISAAR(CPF) 5.2.1 Dates of existence; ISDF 5.2.1 Dates."@en .

dt:creation a skos:Concept, rico:DateType ;
    skos:inScheme dt: ;
    skos:topConceptOf dt: ;
    skos:prefLabel "Creation"@en, "Création"@fr, "Creación"@es ;
    skos:definition "The dates at which the records were created."@en ;
    skos:scopeNote "Source element: ISAD(G) 3.1.3 Date(s), where the dates are of creation."@en .

dt:accumulation a skos:Concept, rico:DateType ;
    skos:inScheme dt: ;
    skos:topConceptOf dt: ;
    skos:prefLabel "Accumulation"@en, "Accumulation"@fr, "Acumulación"@es ;
    skos:definition "The dates at which the records were accumulated, as distinct from when they were created."@en ;
    skos:scopeNote "Source element: ISAD(G) 3.1.3 Date(s), where the dates are of accumulation."@en .

dt:descriptive a skos:Concept, rico:DateType ;
    skos:inScheme dt: ;
    skos:topConceptOf dt: ;
    skos:prefLabel "Description"@en, "Description"@fr, "Descripción"@es ;
    skos:definition "The dates at which the description itself was prepared or revised, not the dates of the records it describes."@en ;
    skos:scopeNote "Source element: ISAD(G) 3.7.3 Date(s) of descriptions."@en .

dt:custody a skos:Concept, rico:DateType ;
    skos:inScheme dt: ;
    skos:topConceptOf dt: ;
    skos:prefLabel "Custody"@en, "Garde"@fr, "Custodia"@es ;
    skos:definition "The dates during which an agent held custody of the records."@en ;
    skos:scopeNote "Source element: ISAD(G) 3.2.3 Archival history, where it dates a period of custody."@en .
