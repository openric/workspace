#!/bin/bash
# =============================================================================
# bin/release - release a commit of the OpenRiC Workspace: pushed to main, checked by CI, tagged (signed), deployed to
# the live instance, its evidence published with the tag and its note dropped for KM.
# =============================================================================
#   bin/release VERSION KIND [KM-NOTE]
#
#   VERSION  the release, such as 0.0.166: the local main's HEAD must be the commit "vVERSION ..." whose VERSION file
#            says the same.
#   KIND     defect, security, hardening or conformance: required while the openric feature freeze holds.
#   KM-NOTE  a Markdown note of the release for KM (optional); without it, the commit message is the note.
#
# Run from the development clone, by the owner of the live directory (deploy/README.md, Release and deploy). Every
# Workspace release goes through this script: nothing is pushed, tagged or deployed before the checks below pass.
#
# The feature freeze (Dr Johan Pieterse, 23 November 2026). Feature releases of Heratio, PSIS and OpenRiC are stopped
# until he lifts it. Workspace versions are all patches, so the release states its kind; while openric is frozen only
# defect, security, hardening or conformance is let through, and a commit subject that names a roadmap phase or
# something new is refused. The workbench's freeze check is called as well. ponytail: judged by what the release says,
# not by its diff; the approval of the release command is the real check.
# Copyright (C) 2026 Johan Pieterse / Plain Sailing Information Systems
# SPDX-License-Identifier: AGPL-3.0-or-later
# =============================================================================
set -e
set -o pipefail

v=${1:-}; kind=${2:-}; note=${3:-}
[ -n "$v" ] || { echo "Usage: bin/release VERSION KIND [KM-NOTE]"; exit 2; }

REPO=https://github.com/openric/workspace.git
SRC=$(cd "$(dirname "$0")/.." && pwd)
LIVE=${WORKSPACE_LIVE:-/usr/share/nginx/openric-workspace-live}
cd "$SRC"
sha=$(git rev-parse HEAD)
subject=$(git log -1 --format=%s "$sha")

# 1. The feature freeze, before anything else.
G=/usr/share/nginx/workbench/bin/release-freeze-check
if [ -x "$G" ]; then "$G" openric patch "$subject" || exit 1; fi
if grep -qxF openric "${RELEASE_FREEZE_FILE:-/var/lib/workbench/release-freeze}" 2>/dev/null; then
  case "$kind" in
    defect|security|hardening|conformance) ;;
    *) echo "RELEASE REFUSED: openric is under the feature freeze; give the release's kind (defect, security, hardening or conformance), not '${kind:-none}'."; exit 1 ;;
  esac
  if printf '%s' "$subject" | grep -qiE '(^|[^a-z])(phase [0-9]+|new)([^a-z]|$)'; then
    echo "RELEASE REFUSED: openric is under the feature freeze, and the subject names a roadmap phase or something new."; exit 1
  fi
fi

# 2. The commit is the release it says it is.
[ "$(git rev-parse --abbrev-ref HEAD)" = main ] || { echo "Release from main."; exit 1; }
[ -z "$(git status --porcelain)" ] || { echo "Commit or set aside the uncommitted changes first."; exit 1; }
printf '%s' "$subject" | grep -q "^v$v " || { echo "HEAD ($sha) is not v$v"; exit 1; }
[ "$(git show "$sha:VERSION" | tr -d '[:space:]')" = "$v" ] || { echo "VERSION in $sha is not $v"; exit 1; }
! git rev-parse -q --verify "refs/tags/v$v" > /dev/null || { echo "v$v is already tagged"; exit 1; }
[ -z "$note" ] || [ -f "$note" ] || { echo "No KM note at $note"; exit 1; }

# 3. The live instance and the translations.
# From v0.0.144 an experimental module is off unless named; the demonstration instance offers them all (MODULES.md).
grep -q '^WORKSPACE_MODULES=' "$LIVE/.env" || { echo "Add WORKSPACE_MODULES=all to $LIVE/.env first, or the demonstration loses its experimental modules."; exit 1; }
# From v0.0.145 the interface translations must be as current as PSIS and Heratio: else bin/lang-refresh, commit, release that.
bin/lang-refresh --check || { echo "A language is behind PSIS or Heratio: run bin/lang-refresh and commit first."; exit 1; }

# Wait for the CI run on a commit (full SHA) or a tag (branch name) to finish; print its conclusion.
w() {
  local flag=$1 ref=$2 id="" i
  for i in $(seq 1 90); do
    id=$(gh run list -R openric/workspace --workflow ci.yml "$flag" "$ref" --limit 1 --json databaseId --jq '.[0].databaseId' 2>/dev/null || true)
    [ -n "$id" ] && break
    sleep 10
  done
  [ -n "$id" ] || { echo "no run"; return 1; }
  # Poll until the run has finished: gh run watch can return early on a passing network error.
  for i in $(seq 1 240); do
    [ "$(gh run view -R openric/workspace "$id" --json status --jq .status 2>/dev/null)" = completed ] && break
    sleep 15
  done
  gh run view -R openric/workspace "$id" --json conclusion --jq .conclusion
}

# 4. Pushed, and checked by CI on main.
for i in $(seq 1 40); do git -c credential.helper='!gh auth git-credential' push -q "$REPO" "$sha:refs/heads/main" && break; sleep 30; done
echo "pushed $sha"
r=$(w --commit "$sha"); echo "main: $r"; [ "$r" = success ] || exit 1
# GitHub's list of successful runs, which the tag check reads, can lag behind the run itself.
for i in $(seq 1 60); do
  n=$(gh api "repos/openric/workspace/actions/workflows/ci.yml/runs?head_sha=$sha" --jq '[.workflow_runs[] | select(.head_branch == "main" and .conclusion == "success")] | length' 2>/dev/null || echo 0)
  [ "$n" -gt 0 ] && break
  sleep 20
done

# 5. Tagged, signed, and the tag's own check.
git tag -s "v$v" -m "v$v" "$sha"
for i in $(seq 1 40); do git -c credential.helper='!gh auth git-credential' push -q "$REPO" "v$v" && break; sleep 30; done
echo "tagged v$v"
r=$(w --branch "v$v"); echo "tag: $r"; [ "$r" = success ] || exit 1

# 6. Deployed, and the live instance checked.
log=$(mktemp)
(cd "$LIVE" && ./deploy/deploy.sh "v$v") > "$log" 2>&1 || { tail -22 "$log"; echo "deploy failed; its log is $log"; exit 1; }
tail -22 "$log"
grep -q "Deployed v$v" "$log" || { echo "deploy did not report v$v; its log is $log"; exit 1; }
# The object store, and the log of inferences.
sudo -n -u www-data /usr/bin/php "$LIVE/artisan" workspace:ocfl:verify
sudo -n -u www-data /usr/bin/php "$LIVE/artisan" workspace:ai:verify

# 7. The release's evidence (deploy.sh from v0.0.144 on writes it), published as the tag's GitHub release.
if [ -f "$LIVE/storage/app/releases/v$v.md" ]; then
  gh release create "v$v" -R openric/workspace --verify-tag --title "v$v" --notes-file "$LIVE/storage/app/releases/v$v.md" && echo "evidence published"
else
  echo "no evidence file for v$v (deployed by the previous release's gate)"
fi

# 8. The note for KM, with the release's kind.
km=$(mktemp)
if [ -n "$note" ]; then cat "$note" > "$km"; else printf '# OpenRiC Workspace v%s (%s)\n\n%s\n' "$v" "$(date +%F)" "$(git log -1 --format=%B "$sha")" > "$km"; fi
printf '\nRelease kind under the feature freeze: %s.\n' "${kind:-not given}" >> "$km"
if [ -d /var/spool/km-ingest ]; then
  cp "$km" "/var/spool/km-ingest/openric-workspace-$(date +%F)-v$v.md" && echo "km v$v"
else
  echo "no KM drop folder on this host; the note is $km"
fi
