#!/usr/bin/env bash
# =============================================================================
# bin/install - install the OpenRiC Workspace on a fresh Ubuntu 24.04 server, from its git clone
# =============================================================================
# After Heratio's bin/install: one command, in stages, each skipped when already done, so a stopped run is run again
# and carries on. It does what INSTALL.md describes step by step, which stays the reference.
#
#   git clone https://github.com/openric/workspace.git /usr/share/nginx/openric-workspace-live
#   cd /usr/share/nginx/openric-workspace-live
#   sudo bin/install --domain=archives.example.org --institution="Riverside Archives" \
#       --admin-name="Your Name" --admin-email=you@example.org --https
#
# Options:
#   --domain=HOST            the host name the Workspace answers on (required)
#   --institution=NAME       the first institution (required)
#   --admin-name=NAME        the first administrator (required)
#   --admin-email=EMAIL      their sign-in (required)
#   --base-iri=IRI           where the institution's identifiers start (default https://HOST); chosen once, keep it
#   --language=TAG           the language names are written in (default en)
#   --ref=TAG                the release to install (default: the newest tag; --ref=current keeps the checkout)
#   --db-name=NAME           database and role (default openric_workspace)
#   --modules=LIST           WORKSPACE_MODULES: experimental modules to offer, or all (MODULES.md; default none)
#   --https                  take a certificate from Let's Encrypt (certbot) and set secure cookies
#   --demo                   load the demonstration dataset after installing
#   --skip-packages          do not apt-get install (they are there already)
#   --skip-nginx             do not write the nginx site
#   --non-interactive        never ask; fail on what is missing
#
# Stages:
#    1. Preflight      Ubuntu, root, the clone, the options
#    2. Packages       PHP 8.3, PostgreSQL 16 with pgvector, nginx, the file tools (INSTALL.md, "What it needs")
#    3. Database       the role and database with a generated password, and pgvector (as PostgreSQL's superuser)
#    4. Code           the release checked out; composer install --no-dev
#    5. Settings       .env from .env.example, the application key, readable by the web server only
#    6. Folders        storage/ for www-data, the php-fpm drop-in (ProtectSystem=full), upload limits
#    7. Schema         migrations, the audit signing key, the institution and its administrator
#    8. Caches         config, routes and views cached; workspace:preflight
#    9. nginx          the site, and with --https its certificate
#   10. Background     the scheduler's cron entry and the files worker without outside network
#   11. Scanners       ClamAV's daemon and Siegfried's signatures
#   12. Check          the site answers; the audit chain and the object store verify
#   13. Report         where it is, who signs in, what to back up
#
# Copyright (C) 2026 Johan Pieterse / Plain Sailing Information Systems
# SPDX-License-Identifier: AGPL-3.0-or-later
# =============================================================================
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DOMAIN="" INSTITUTION="" ADMIN_NAME="" ADMIN_EMAIL="" BASE_IRI="" LANGUAGE=en REF="" DB_NAME=openric_workspace MODULES=""
HTTPS=0 DEMO=0 SKIP_PACKAGES=0 SKIP_NGINX=0 NON_INTERACTIVE=0
PHP=/usr/bin/php8.3

for arg in "$@"; do
    case "$arg" in
        --domain=*) DOMAIN="${arg#*=}" ;;
        --institution=*) INSTITUTION="${arg#*=}" ;;
        --admin-name=*) ADMIN_NAME="${arg#*=}" ;;
        --admin-email=*) ADMIN_EMAIL="${arg#*=}" ;;
        --base-iri=*) BASE_IRI="${arg#*=}" ;;
        --language=*) LANGUAGE="${arg#*=}" ;;
        --ref=*) REF="${arg#*=}" ;;
        --db-name=*) DB_NAME="${arg#*=}" ;;
        --modules=*) MODULES="${arg#*=}" ;;
        --https) HTTPS=1 ;;
        --demo) DEMO=1 ;;
        --skip-packages) SKIP_PACKAGES=1 ;;
        --skip-nginx) SKIP_NGINX=1 ;;
        --non-interactive) NON_INTERACTIVE=1 ;;
        -h|--help) sed -n '2,45p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) echo "Unknown option: $arg (see --help)" >&2; exit 2 ;;
    esac
done

say()  { printf '\n\033[1;36m==> %s\033[0m\n' "$*"; }
ok()   { printf '    \033[1;32mok\033[0m %s\n' "$*"; }
warn() { printf '    \033[1;33m!!\033[0m %s\n' "$*"; }
die()  { printf '    \033[1;31mfailed\033[0m %s\n' "$*" >&2; exit 1; }
ask()  {
    local var="$1" question="$2"
    [ -n "${!var}" ] && return
    local flag="${var,,}"; flag="${flag//_/-}"
    [ "$NON_INTERACTIVE" -eq 1 ] && die "$question is needed: give --$flag (see --help)"
    read -rp "    $question: " "$var"
    [ -n "${!var}" ] || die "$question is needed"
}
# The clone's owner runs git and composer; www-data runs artisan, so nothing under storage/ is root's.
OWNER="${SUDO_USER:-$(stat -c %U "$DIR")}"
as_owner() { sudo -u "$OWNER" -H "$@"; }
artisan() { sudo -u www-data "$PHP" "$DIR/artisan" "$@"; }
env_set() {
    local key="$1" value="$2"
    if grep -qE "^#? ?$key=" "$DIR/.env"; then
        sed -i -E "s|^#? ?$key=.*|$key=$(printf '%s' "$value" | sed 's/[|&\\]/\\&/g')|" "$DIR/.env"
    else
        printf '%s=%s\n' "$key" "$value" >> "$DIR/.env"
    fi
}
env_get() { grep -E "^$1=" "$DIR/.env" 2>/dev/null | tail -1 | cut -d= -f2- | sed 's/^"//; s/"$//'; }

# =============================================================================
say "1/13 Preflight"
[ "$(id -u)" -eq 0 ] || die "run it with sudo: sudo bin/install ..."
[ -d "$DIR/.git" ] || die "$DIR is not a git clone of the Workspace (git clone https://github.com/openric/workspace.git)"
. /etc/os-release 2>/dev/null || true
[ "${ID:-}" = ubuntu ] && [ "${VERSION_ID:-}" = 24.04 ] && ok "Ubuntu 24.04" || warn "written for Ubuntu 24.04; this is ${PRETTY_NAME:-unknown}, so package names may differ"
ask DOMAIN "The host name (e.g. archives.example.org)"
ask INSTITUTION "The institution's name"
ask ADMIN_NAME "The first administrator's name"
ask ADMIN_EMAIL "The first administrator's e-mail"
BASE_IRI="${BASE_IRI:-https://$DOMAIN}"
[[ "$BASE_IRI" == https://* ]] || die "the base IRI must be https: $BASE_IRI"
[[ "$DB_NAME" =~ ^[a-z_][a-z0-9_]*$ ]] || die "--db-name takes lower-case letters, digits and _"
ok "$INSTITUTION at https://$DOMAIN, identifiers under $BASE_IRI, code in $DIR owned by $OWNER"

# =============================================================================
say "2/13 Packages"
if [ "$SKIP_PACKAGES" -eq 1 ]; then
    ok "skipped (--skip-packages)"
else
    export DEBIAN_FRONTEND=noninteractive
    apt-get update -qq
    apt-get install -y -qq nginx postgresql postgresql-contrib postgresql-16-pgvector \
        php8.3-fpm php8.3-cli php8.3-pgsql php8.3-mbstring php8.3-xml php8.3-intl php8.3-curl php8.3-zip php8.3-gd php8.3-imagick \
        composer git unzip curl acl \
        imagemagick poppler-utils libimage-exiftool-perl ffmpeg ghostscript rsync fonts-dejavu-core 7zip \
        libreoffice-core libreoffice-writer libreoffice-calc libreoffice-impress clamav-daemon \
        certbot python3-certbot-nginx >/dev/null
    ok "PHP 8.3, PostgreSQL 16 with pgvector, nginx and the file tools"
    command -v sf >/dev/null && ok "Siegfried" || warn "Siegfried is not installed: files stay unidentified until it is (https://github.com/richardlehane/siegfried, Install)"
fi
for need in "$PHP" composer git psql nginx; do command -v "$need" >/dev/null || die "missing: $need"; done
"$PHP" -m | grep -qi '^pdo_pgsql$' || die "PHP lacks pdo_pgsql (php8.3-pgsql)"
"$PHP" -m | grep -qi '^sodium$' || die "PHP lacks sodium, which signs the audit log"

# =============================================================================
say "3/13 Database"
[ -f "$DIR/.env" ] || cp "$DIR/.env.example" "$DIR/.env"
DB_PASS="$(env_get DB_PASSWORD)"
if sudo -u postgres psql -tAc "SELECT 1 FROM pg_roles WHERE rolname = '$DB_NAME'" | grep -q 1; then
    [ -n "$DB_PASS" ] || die "the role $DB_NAME exists but .env has no DB_PASSWORD for it"
    ok "role $DB_NAME exists"
else
    DB_PASS="$(openssl rand -base64 30 | tr -dc 'A-Za-z0-9' | head -c 32)"
    sudo -u postgres psql -q -c "CREATE ROLE \"$DB_NAME\" LOGIN PASSWORD '$DB_PASS'"
    ok "role $DB_NAME made, with a generated password (kept in .env)"
fi
if sudo -u postgres psql -tAc "SELECT 1 FROM pg_database WHERE datname = '$DB_NAME'" | grep -q 1; then
    ok "database $DB_NAME exists"
else
    sudo -u postgres createdb --owner="$DB_NAME" --encoding=UTF8 --template=template0 "$DB_NAME"
    ok "database $DB_NAME made"
fi
# pgvector needs the superuser; pg_trgm and unaccent are trusted, so the migrations make them as the owner.
sudo -u postgres psql -q -d "$DB_NAME" -c 'CREATE EXTENSION IF NOT EXISTS vector' && ok "pgvector"

# =============================================================================
say "4/13 Code"
git config --global --add safe.directory "$DIR" 2>/dev/null || true
as_owner git -C "$DIR" fetch --tags --quiet origin || warn "could not fetch from origin; installing what is checked out"
if [ "$REF" = current ]; then
    ok "keeping $(as_owner git -C "$DIR" describe --tags --always)"
else
    REF="${REF:-$(as_owner git -C "$DIR" tag --sort=-v:refname | head -1)}"
    [ -n "$REF" ] || die "no release tag to install; give --ref=current to install the checkout"
    as_owner git -C "$DIR" -c advice.detachedHead=false checkout --quiet "$REF"
    ok "release $REF"
fi
as_owner composer --working-dir="$DIR" install --no-dev --optimize-autoloader --no-interaction --quiet
ok "composer install --no-dev"

# =============================================================================
say "5/13 Settings"
SCHEME=http; [ "$HTTPS" -eq 1 ] && SCHEME=https
env_set APP_NAME '"OpenRiC Workspace"'
env_set APP_ENV production
env_set APP_DEBUG false
env_set APP_URL "$SCHEME://$DOMAIN"
env_set LOG_LEVEL info
env_set DB_CONNECTION pgsql
env_set DB_HOST 127.0.0.1
env_set DB_PORT 5432
env_set DB_DATABASE "$DB_NAME"
env_set DB_USERNAME "$DB_NAME"
env_set DB_PASSWORD "$DB_PASS"
env_set SESSION_SECURE_COOKIE "$([ "$HTTPS" -eq 1 ] && echo true || echo false)"
env_set QUEUE_CONNECTION database
env_set WORKSPACE_OPERATORS "$ADMIN_EMAIL"
[ -n "$MODULES" ] && env_set WORKSPACE_MODULES "$MODULES"
[ -n "$(env_get APP_KEY)" ] || "$PHP" "$DIR/artisan" key:generate --force --no-interaction >/dev/null
chown "$OWNER":www-data "$DIR/.env" && chmod 640 "$DIR/.env"
ok ".env written; mail is logged until MAIL_* are set (INSTALL.md, step 4)"
[ "$(env_get MAIL_MAILER)" = smtp ] || warn "set MAIL_MAILER=smtp and MAIL_* in .env before people rely on it: until then preflight waives mail"

# =============================================================================
say "6/13 Folders"
chown -R www-data:www-data "$DIR/storage" "$DIR/bootstrap/cache"
setfacl -R -m u:www-data:rwx -m u:"$OWNER":rwx "$DIR/storage" "$DIR/bootstrap/cache"
setfacl -R -d -m u:www-data:rwx -m u:"$OWNER":rwx "$DIR/storage" "$DIR/bootstrap/cache"
mkdir -p /etc/systemd/system/php8.3-fpm.service.d
cat > /etc/systemd/system/php8.3-fpm.service.d/openric-workspace-storage.conf <<UNIT
# Written by bin/install: Ubuntu's php8.3-fpm runs with ProtectSystem=full, so the Workspace's storage must be allowed.
[Service]
ReadWritePaths=$DIR/storage
ReadWritePaths=$DIR/bootstrap/cache
UNIT
cat > /etc/php/8.3/fpm/conf.d/99-openric-workspace.ini <<INI
; Written by bin/install: uploads as large as WORKSPACE_MAX_UPLOAD_MB (60).
upload_max_filesize = 64M
post_max_size = 64M
memory_limit = 512M
INI
systemctl daemon-reload && systemctl restart php8.3-fpm
ok "storage/ for www-data; php-fpm may write it and take 64 MB uploads"

# =============================================================================
say "7/13 Schema, audit key and institution"
artisan migrate --force --no-interaction
artisan workspace:audit:create-key --if-missing
if sudo -u postgres psql -tAc "SELECT 1 FROM institutions LIMIT 1" "$DB_NAME" 2>/dev/null | grep -q 1; then
    ok "already installed: an institution exists"
else
    artisan workspace:install --no-interaction --institution="$INSTITUTION" --base-iri="$BASE_IRI" \
        --admin-name="$ADMIN_NAME" --admin-email="$ADMIN_EMAIL" --language="$LANGUAGE" | tee /root/openric-workspace-install.log
    chmod 600 /root/openric-workspace-install.log
    ok "the administrator's password is shown above once, and kept in /root/openric-workspace-install.log: note it, then delete that file"
fi
if [ "$DEMO" -eq 1 ]; then artisan workspace:demo && ok "demonstration dataset loaded"; fi

# =============================================================================
say "8/13 Caches and preflight"
# What a server without https or mail yet cannot pass is waived by name, in .env (preflight reads it from the cached
# configuration); the waiver goes once https and mail are set, and preflight then checks them.
WAIVE=""
[ "$HTTPS" -eq 1 ] || WAIVE="https,cookies"
[ "$(env_get MAIL_MAILER)" = smtp ] || WAIVE="${WAIVE:+$WAIVE,}mail"
env_set WORKSPACE_PREFLIGHT_WAIVE "$WAIVE"
[ -z "$WAIVE" ] || warn "preflight waives $WAIVE until they are set (WORKSPACE_PREFLIGHT_WAIVE in .env)"
artisan config:cache >/dev/null && artisan route:cache >/dev/null && artisan view:cache >/dev/null
ok "config, routes and views cached"
artisan workspace:preflight || warn "preflight refused the configuration above; put it right before the Workspace holds anything"

# =============================================================================
say "9/13 nginx"
if [ "$SKIP_NGINX" -eq 1 ]; then
    ok "skipped (--skip-nginx)"
else
    SITE="/etc/nginx/sites-available/$DOMAIN.conf"
    if [ -f "$SITE" ] && ! grep -q 'Written by bin/install' "$SITE"; then
        warn "$SITE exists and was not written by bin/install: left as it is"
    else
        cat > "$SITE" <<NGINX
# Written by bin/install for the OpenRiC Workspace (INSTALL.md, step 7).
server {
    server_name $DOMAIN;
    root $DIR/public;
    index index.php;
    charset utf-8;
    client_max_body_size 64m;

    add_header X-Frame-Options        "SAMEORIGIN"                      always;
    add_header X-Content-Type-Options "nosniff"                         always;
    add_header Referrer-Policy        "strict-origin-when-cross-origin" always;

    location / { try_files \$uri \$uri/ /index.php?\$query_string; }
    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt  { access_log off; log_not_found off; }
    location ~ /\.(?!well-known).* { deny all; }

    location ~ ^/index\.php(/|\$) {
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
        fastcgi_split_path_info ^(.+\.php)(/.*)\$;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME \$realpath_root\$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT \$realpath_root;
        fastcgi_hide_header X-Powered-By;
        fastcgi_read_timeout 60;
    }
    location ~ \.php\$ { return 404; }

    listen 80;
    listen [::]:80;
}
NGINX
        ln -sf "$SITE" "/etc/nginx/sites-enabled/$DOMAIN.conf"
        nginx -t -q && systemctl reload nginx
        ok "$SITE"
    fi
    if [ "$HTTPS" -eq 1 ]; then
        certbot --nginx --non-interactive --agree-tos --redirect -m "$ADMIN_EMAIL" -d "$DOMAIN" && ok "certificate for $DOMAIN" \
            || warn "certbot failed: is $DOMAIN's DNS pointing here and port 80 open? Run: sudo certbot --nginx -d $DOMAIN"
    fi
fi

# =============================================================================
say "10/13 Scheduler and files worker"
sed "s|/usr/share/nginx/openric-workspace-live|$DIR|g" "$DIR/deploy/cron/openric-workspace" > /etc/cron.d/openric-workspace
chown root:root /etc/cron.d/openric-workspace && chmod 0644 /etc/cron.d/openric-workspace
ok "the scheduler runs each minute as www-data"
sed "s|/usr/share/nginx/openric-workspace-live|$DIR|g" "$DIR/deploy/systemd/openric-workspace-files.service" > /etc/systemd/system/openric-workspace-files.service
systemctl daemon-reload && systemctl enable --now --quiet openric-workspace-files
env_set WORKSPACE_FILES_WORKER true
artisan config:cache >/dev/null
ok "the files worker runs converters with no outside network"

# =============================================================================
say "11/13 ClamAV and Siegfried"
if systemctl list-unit-files clamav-daemon.service >/dev/null 2>&1; then
    systemctl enable --now --quiet clamav-daemon && ok "ClamAV's daemon (it loads its signatures in a few minutes)"
else
    env_set WORKSPACE_VIRUS_SCANNER ""; artisan config:cache >/dev/null
    warn "no ClamAV: uploads are kept as not scanned"
fi
if command -v sf >/dev/null; then sudo -u www-data sf -update >/dev/null 2>&1 && ok "Siegfried's PRONOM signatures" || warn "sf -update failed"; fi

# =============================================================================
say "12/13 Check"
CODE="$(curl -s -o /dev/null -w '%{http_code}' -H "Host: $DOMAIN" http://127.0.0.1/sign-in || true)"
[ "$CODE" = 200 ] || [ "$CODE" = 301 ] || [ "$CODE" = 302 ] && ok "the sign-in page answers ($CODE)" || warn "the sign-in page answered $CODE"
artisan workspace:audit:verify && ok "audit chain"
artisan workspace:ocfl:verify && ok "object store"

# =============================================================================
say "13/13 Done"
cat <<REPORT
    The OpenRiC Workspace $(as_owner git -C "$DIR" describe --tags --always) is installed.

      Address          $SCHEME://$DOMAIN/sign-in
      Administrator    $ADMIN_EMAIL (password shown at stage 7)
      Code             $DIR
      Database         $DB_NAME (its password is in .env)

    Before it holds anything:
      - set MAIL_* in .env, then sudo -u www-data php artisan config:cache
      - back up the audit signing key, storage/keys/, apart from the server: without it nothing can be changed
      - take a backup and test it: bin/backup, then bin/restore on another server (deploy/runbooks/restoring.md)
    New releases: deploy/deploy.sh vX.Y.Z (deploy/runbooks/updating.md).
REPORT
