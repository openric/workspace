# OpenRiC Workspace - settings for the Docker install. Copy to docker/.env.docker and set the CHANGEME_ values:
# the Workspace refuses to start while any is left, since this file is public and its values would be known.
# Copyright (C) 2026 Johan Pieterse / Plain Sailing Information Systems
# SPDX-License-Identifier: AGPL-3.0-or-later

# Where people reach it. Behind a proxy that gives https, set the https address here.
APP_URL=http://localhost:8090
WORKSPACE_PORT=8090

# The first institution and its administrator. The base IRI starts every identifier it mints: choose it once.
WORKSPACE_INSTITUTION="Riverside Archives"
WORKSPACE_BASE_IRI=https://archives.example.org
WORKSPACE_ADMIN_NAME="Your Name"
WORKSPACE_ADMIN_EMAIL=you@example.org
WORKSPACE_ADMIN_PASSWORD=CHANGEME_at_least_12_characters
WORKSPACE_LANGUAGE=en

# The database: the Workspace's own role, and PostgreSQL's superuser (only the database container and bin/restore use it).
DB_DATABASE=openric_workspace
DB_USERNAME=openric_workspace
DB_PASSWORD=CHANGEME_database_password
DB_ROOT_PASSWORD=CHANGEME_superuser_password

# Optional.
# WORKSPACE_MODULES=all          experimental modules to offer (MODULES.md)
# WORKSPACE_DEMO=true            load the demonstration dataset at the first start
# WORKSPACE_TIMEZONE=Africa/Johannesburg
# WORKSPACE_VIRUS_SCANNER=      a ClamAV client that reaches a daemon beside the container; empty, uploads are not scanned
# WITH_OFFICE=true               build with LibreOffice, for PDF copies of office documents
# UBUNTU_MIRROR=http://za.archive.ubuntu.com/ubuntu   an Ubuntu mirror nearer than archive.ubuntu.com
# WORKSPACE_BACKUPS=./backups    the host folder bin/backup writes to and bin/restore reads from (/backups inside)
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.example.org
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=archives@example.org
